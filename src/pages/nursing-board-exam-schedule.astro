---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import PrcSubscribe from '../components/PrcSubscribe.astro';
import PrcScheduleStatus from '../components/PrcScheduleStatus.astro';
import scheduleStatus from '../data/prc/next-schedule-status.json';
import prcRules from '../data/prc/2026.json';
import { PRC_PROFESSIONS, resolveGroup, scheduleSentence } from '../lib/prcProfessions';
import type { PrcExamEntry, PrcRules } from '../lib/rules/types';
import { SITE } from '../../site.config';
import { educationEvents } from '../lib/prcCalendar';
import { todayInManila } from '../lib/today.mjs';
import pnleHistory from '../data/prc/pnle-history.json';
import { upcomingExams } from '../lib/prcUpcoming';

const meta = prcRules.meta;
const byName = new Map((prcRules.exams as PrcExamEntry[]).map((e) => [e.exam, e]));
const nursing = PRC_PROFESSIONS.find((g) => g.id === 'nursing');
if (!nursing) throw new Error('PRC_PROFESSIONS no longer has a "nursing" group.');
const rounds = resolveGroup(nursing, byName, prcRules.year);
const [first, second] = rounds;

/* Every date on this page comes from the PRC rule JSON — next year's
   resolution updates the copy without anyone re-typing a date. */
const fmt = (d: string | null | undefined): string =>
  d
    ? new Date(d + 'T00:00:00').toLocaleDateString('en-PH', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      })
    : 'to be announced';

const nextYear = prcRules.year + 1;
/* PRC published the Aug–Sep 2026 results on 2026-09-18; the date lives in the
   rule JSON (`results_released`) so this page and the PRC table cannot disagree.
   The status copy below is written for "both rounds done" — the guard makes the
   build fail loudly when the data rolls over to a year whose rounds are ahead. */
if (!second.results_released) {
  throw new Error(
    'nursing page copy assumes the second PNLE round has results_released set in src/data/prc/<year>.json; ' +
      'rewrite the status paragraph and FAQs before rolling over to a year whose rounds are still ahead.',
  );
}
const released = fmt(second.results_released);
const firstReleased = fmt(first.results_released ?? first.results_target);

/* PNLE results history (src/data/prc/pnle-history.json — every row from a PRC press release). */
const historyRounds = pnleHistory.rounds;
const heldRounds = historyRounds.filter((r) => r.first_date !== null);
const pct = (n: number | null) => (n === null ? '—' : `${n.toFixed(2)}%`);
const num = (n: number | null) => (n === null ? '—' : n.toLocaleString('en-PH'));
const rates = heldRounds.map((r) => r.pass_rate as number);
const lowest = heldRounds[rates.indexOf(Math.min(...rates))]!;
const highest = heldRounds[rates.indexOf(Math.max(...rates))]!;
const workingDays = heldRounds.map((r) => r.working_days_to_results as number);
const recent = heldRounds.slice(-4).reverse();
const historyFrom = heldRounds[0]!.round.split(' ').at(-1);
const historyTo = heldRounds.at(-1)!.round.split(' ').at(-1);
/* EducationEvent markup for any upcoming round (none while both 2026 rounds are past). */
const eventSchema = educationEvents(
  prcRules as PrcRules,
  rounds,
  `${SITE.url}/nursing-board-exam-schedule/`,
  todayInManila(),
);
/* Unpublished dates must not become a precise countdown or a month-specific promise. */
const monthOf = (d: string): string => new Date(d + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long' });
const firstMonth = monthOf(first.first_date);
const secondMonth = monthOf(second.first_date);
const today = todayInManila();
const checkedLabel = fmt(scheduleStatus.checked_on);
const description = `PNLE ${nextYear} schedule status, filing dates and nursing board exam requirements. Official PRC links, document checklist and ${prcRules.year} dates for reference.`;
const title = `PNLE ${nextYear} Schedule: Exam Dates, Filing & Requirements`;
/* Links from the cluster's strongest page to the exam pages whose rounds are next. */
const otherExams = upcomingExams(prcRules.exams as PrcExamEntry[], today, 45)
  .filter((u) => u.href && u.href !== '/nursing-board-exam-schedule/')
  .slice(0, 5)
  .map((u, i, all) => ({
    ...u,
    text: `(${u.entry.dates_display.replace(/, \d{4}.*$/, '')}${u.inProgress ? ', under way' : ''})${i < all.length - 1 ? ',' : '.'}`,
  }));
if (title.length > 65) throw new Error(`nursing page title is ${title.length} chars (max 65): ${title}`);

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Nursing Board Exam Schedule 2026 (PNLE)',
  description: `PNLE ${prcRules.year} schedule per PRC Resolution No. 2113, s. 2025: exam dates, application windows and target result dates for both rounds.`,
  url: `${SITE.url}/nursing-board-exam-schedule/`,
  creator: { '@type': 'Organization', name: 'Professional Regulation Commission (source data)' },
  isBasedOn: meta.official_source_url,
  dateModified: meta.last_verified,
  keywords: ['PNLE', 'nursing board exam schedule 2026', 'PRC', 'Philippines'],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${SITE.url}/data/prc-board-exam-schedule-2026.json`,
    },
  ],
  temporalCoverage: `${meta.effective_from}/${meta.effective_to}`,
  spatialCoverage: { '@type': 'Place', name: 'Philippines' },
  isPartOf: `${SITE.url}/prc-board-exam-schedule/`,
};

const faqs = [
  {
    q: `How many days before the PNLE ${nextYear}?`,
    a: `An official countdown is not available: we did not locate confirmed ${nextYear} exam dates in the PRC sources reviewed on ${checkedLabel}. A countdown made by adding one year to a ${prcRules.year} date would be a guess. Check PRC for the new schedule before planning around a specific day.`,
  },
  {
    q: 'When is the next PNLE?',
    a: `Both ${prcRules.year} rounds (${first.dates_display} and ${second.dates_display}) have been held. We did not locate an official ${nextYear} PNLE schedule in our source review on ${checkedLabel}. The February/August dates from ${prcRules.year} are historical reference, not confirmation of the next exam.`,
  },
  {
    q: 'When is the nursing board exam in 2026?',
    a: `The Philippine Nurse Licensure Examination (PNLE) had two rounds in 2026: ${scheduleSentence(rounds)} Both rounds ran for two days each and have now been held.`,
  },
  {
    q: 'When were the PNLE August 2026 results released?',
    a: `On ${released} — the target date printed in Resolution No. 2113, s. 2025, and five working days after the rescheduled September 11–12 sittings. 28,652 of 37,359 examinees passed (76.69%); 21 results were withheld pending PRC's determination of the examinees' liabilities. The list of passers is on prc.gov.ph, and per-subject ratings are in LERIS once PRC opens verification for the exam.`,
  },
  {
    q: 'How do I apply for the PNLE?',
    a: 'File online through LERIS (online.prc.gov.ph) within the application window: create or log in to your account, choose the Nurses licensure examination, upload your documents, pay the fee, and book an appointment at your chosen PRC office. Applications after the deadline are not accepted except in justifiable cases defined by PRC rules.',
  },
  {
    q: 'How many times a year is the PNLE given?',
    a: `Twice. In ${prcRules.year} the rounds were ${first.dates_display} and ${second.dates_display}, so a candidate who misses the first filing window can target the second round.`,
  },
  {
    q: 'What happens if I fail the PNLE three times?',
    a: 'The current PRC nursing documentary checklist does not list a three-failure refresher requirement; RA 9173 Section 15 sets the passing and conditional-retake rules. Follow the instructions for your application in LERIS and ask PRC about your individual case. Do not apply another profession’s refresher rule to nursing.',
  },
  {
    q: 'Was the August 2026 PNLE rescheduled?',
    a: `Partly. PRC cancelled the August 29–30, 2026 NLE in Region III (San Fernando, Pampanga and Cabanatuan, Nueva Ecija testing centers) because of regionwide flooding and moved it to September 11–12, 2026, and cancelled the second exam day (August 30) in all Metro Manila testing centers because of PAGASA heavy-rainfall warnings, moving it to September 12, 2026. Other testing centers took the exam as scheduled. The results for the whole round were still released on the original target date, ${released}.`,
  },
  {
    q: `When is the PNLE ${nextYear} schedule release date?`,
    a: `We did not locate a confirmed release date in the PRC sources reviewed on ${checkedLabel}. PRC posted its ${prcRules.year} calendar on November 17, 2025, but that historical date does not establish when the ${nextYear} calendar will be published. Use the PRC website for the announcement.`,
  },
  {
    q: `Is there a February ${nextYear} PNLE?`,
    a: `Unconfirmed in the sources reviewed on ${checkedLabel}. The ${prcRules.year} calendar used February and August, but neither a February exam nor its filing window can be treated as official for ${nextYear} until PRC publishes the relevant schedule.`,
  },
  {
    q: `Is there a PNLE in May ${nextYear}?`,
    a: `We have not verified an official May ${nextYear} PNLE date. Do not infer a May sitting from the older May/November cycle, or rule it out solely because ${prcRules.year} used February/August. PRC's new calendar determines the actual months.`,
  },
  {
    q: `When is the ${secondMonth} ${nextYear} PNLE?`,
    a: `We have not verified an official ${secondMonth} ${nextYear} date or filing window. The second ${prcRules.year} round was ${second.dates_display}, with filing from ${fmt(second.application_start)} to ${fmt(second.application_deadline)}. Those dates are reference for ${prcRules.year} only.`,
  },
  {
    q: 'Is Cabanatuan a PNLE testing center?',
    a: `It was in ${prcRules.year}: PRC's August 2026 advisory named San Fernando, Pampanga and Cabanatuan, Nueva Ecija as the Region III testing centers for the NLE. PRC fixes the testing centers for each round in the schedule resolution and the program of examination, so the ${nextYear} list arrives with the ${nextYear} calendar — check the centers offered in LERIS when you file.`,
  },
  {
    q: 'What months is the PNLE given?',
    a: `In ${prcRules.year} the PNLE was given in February and August (PRC Resolution No. 2113, s. 2025 — the resolution states no reason for the change). From 2019 to 2025 it was given in May and November, with two exceptions: both 2020 rounds were postponed for COVID-19 and never held, and the 2021 rounds were July and November. The ${nextYear} months are not yet official.`,
  },
  {
    q: 'What is the PNLE passing rate?',
    a: `Recent rounds: ${recent.map((r) => `${r.round} ${pct(r.pass_rate)} (${num(r.passers)} of ${num(r.examinees)})`).join('; ')}. Across ${historyFrom}–${historyTo} the pass rate ranged from ${pct(lowest.pass_rate)} (${lowest.round}) to ${pct(highest.pass_rate)} (${highest.round}); the larger November cohorts have posted the higher rates. Counts are from PRC's press releases.`,
  },
  {
    q: 'How many days after the exam does PRC release PNLE results?',
    a: `Between ${Math.min(...workingDays)} and ${Math.max(...workingDays)} working days over ${historyFrom}–${historyTo}. Both ${prcRules.year} rounds came out in five working days: ${first.dates_display} on ${firstReleased} and ${second.dates_display} on ${released}. The resolution's printed target is an upper bound, not the usual timing.`,
  },
  {
    q: 'What are the requirements for the nursing board exam?',
    a: 'RA 9173 Section 13 sets the eligibility rules, including the nursing degree, good moral character and citizenship or reciprocity conditions. PRC’s nursing first-timer checklist lists a PSA birth certificate; a PSA marriage certificate/contract for married female applicants; a transcript with scanned picture and the board-examination-purpose remark; and a notarized Certificate of Undertaking signed by the Dean and Registrar. Examination fees apply. Check the linked PRC list and your LERIS instructions for your application.',
  },
  {
    q: 'Is this schedule official?',
    a: `The ${prcRules.year} dates come from PRC Resolution No. 2113, s. 2025 and later PRC advisories. The ${nextYear} exam dates and filing windows remain unconfirmed in this guide following our ${checkedLabel} source review. AyTool is an independent summary; the official calendar and later PRC notices take precedence.`,
  },
  {
    q: 'Kailan ang PNLE 2026?',
    a: `The Philippine Nurse Licensure Examination had two rounds in ${prcRules.year}: ${scheduleSentence(rounds)} Each round was a two-day exam, and both are done.`,
  },
  {
    q: 'Kailan ang susunod na PNLE?',
    a: `Tapos na ang dalawang PNLE round sa ${prcRules.year}. Sa source check namin noong ${checkedLabel}, wala pa kaming nakitang opisyal na ${nextYear} schedule. Hindi pa kumpirmado sa guide na ito ang exam dates at filing window; tingnan ang prc.gov.ph para sa bagong announcement.`,
  },
  {
    q: 'Kailan lalabas ang result ng PNLE 2026?',
    a: `Lumabas na. PRC released the ${second.dates_display} exam results on ${released}, its target date — 28,652 of 37,359 passed (76.69%). The ${first.dates_display} round's results came out on ${firstReleased} — 3,611 of 8,162 passed (44.24%). Check prc.gov.ph for the official list and LERIS for your ratings.`,
  },
];
---

<ToolPageLayout
  title={title}
  description={description}
  path="/nursing-board-exam-schedule/"
  h1={`PNLE ${nextYear} Schedule, Filing Dates & Requirements`}
  faqs={faqs}
  related={['prc', 'letSchedule', 'criminologySchedule', 'physicianSchedule']}
  isApp={false}
  extraSchema={[datasetSchema, ...eventSchema, {
    '@context': 'https://schema.org', '@type': 'Dataset', name: `PNLE Results History ${historyFrom}–${historyTo}`,
    description: 'Independent transcription of PRC result counts and release dates; pass rates are calculated as passers divided by examinees.',
    url: `${SITE.url}/nursing-board-exam-schedule/#pnle-results-history-2019-2026-pass-rates-exam-months-and-re`,
    creator: { '@type': 'Organization', name: SITE.name, url: `${SITE.url}/` },
    dateModified: pnleHistory.meta.last_verified, isBasedOn: pnleHistory.meta.official_source_url,
    distribution: [
      { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${SITE.url}/data/pnle-results-history.csv` },
      { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE.url}/data/pnle-results-history.json` },
    ],
  }]}
>
  <Fragment slot="answer">
    <p>
      <strong>PNLE {nextYear} exam dates and filing windows are unconfirmed in our last PRC source review.</strong>
      {' '}Prepare your application documents below, check the official announcement links, or
      view the completed {prcRules.year} rounds and results.
    </p>
    <PrcScheduleStatus name="PNLE" />
    <nav class="mt-3 flex flex-wrap gap-x-4 gap-y-2 text-sm font-semibold" aria-label="PNLE quick links">
      <a href="#pnle-2027">2027 date and filing status</a>
      <a href="#pnle-requirements">Documents to prepare</a>
      <a href="#how-to-apply-for-the-pnle-leris">LERIS application steps</a>
      <a href="#pnle-2026-exam-dates-and-deadlines">2026 dates and results</a>
    </nav>
  </Fragment>

  <h2 id="pnle-2027">PNLE {nextYear} Schedule and Filing Status</h2>
  <div class="table-scroll">
    <table>
      <caption>PNLE {nextYear}: status at our {checkedLabel} source review</caption>
      <thead><tr><th>What you need</th><th>{nextYear} status in this guide</th><th>Where to confirm</th></tr></thead>
      <tbody>
        <tr><th scope="row">Exam dates and months</th><td>Not verified; February and August are not confirmed</td><td><a href={scheduleStatus.announcements_url}>PRC schedule announcement</a></td></tr>
        <tr><th scope="row">Filing opening and deadline</th><td>Not verified; do not reuse the {prcRules.year} window</td><td><a href="https://online.prc.gov.ph/">LERIS and the new PRC calendar</a></td></tr>
        <tr><th scope="row">Testing centers</th><td>Not verified for {nextYear}</td><td>The program of examination and LERIS</td></tr>
      </tbody>
    </table>
  </div>
  <p>
    The official {prcRules.year} calendar used {firstMonth} and {secondMonth}, following an older
    May/November cycle. A previous year's pattern does not establish {nextYear}'s dates. PRC's
    {' '}<a href={scheduleStatus.previous_release_url}>November 17, 2025 announcement</a> is a
    historical publication date, not a promised release day for the {nextYear} schedule.
  </p>
  <PrcSubscribe slug="nursing" name="PNLE" nextYear={nextYear} />

  <h2 id="pnle-requirements">PNLE Requirements: Documents to Prepare Before Filing</h2>
  <p>
    PRC's <a href={scheduleStatus.requirements_url} target="_blank" rel="noopener">nursing first-timer checklist</a>,
    reviewed on {checkedLabel}, lists the following documents. Preparing them does not mean the
    {nextYear} filing window is open.
  </p>
  <ul>
    <li>PSA birth certificate.</li>
    <li>PSA marriage certificate or contract for married female applicants, as listed by PRC.</li>
    <li>Transcript of records with scanned picture and the remark required for board examination purposes.</li>
    <li>Notarized Certificate of Undertaking signed by the Dean and Registrar.</li>
  </ul>
  <p>
    Examination fees apply; follow the amount and instructions shown for your application in
    <a href="https://online.prc.gov.ph/" target="_blank" rel="noopener">LERIS</a>.
    Eligibility is governed by <a href={scheduleStatus.nursing_law_url} target="_blank" rel="noopener">RA 9173, Section 13</a>:
    the nursing-degree, good-character and citizenship or reciprocity conditions must be met.
    Ask PRC about foreign qualifications or other individual circumstances.
  </p>

  <h2>PNLE {prcRules.year} Exam Dates and Deadlines</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Round</th>
          <th>Exam dates</th>
          <th>Application window</th>
          <th>Results</th>
        </tr>
      </thead>
      <tbody>
        {
          rounds.map((r, i) => (
            <tr>
              <td>{i + 1}</td>
              <td>
                <strong>{r.dates_display}</strong>
              </td>
              <td>
                {fmt(r.application_start)} – {fmt(r.application_deadline)}
              </td>
              <td>
                {r.results_released
                  ? `Released ${fmt(r.results_released)}`
                  : `${fmt(r.results_target)} (target)`}
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    Looking for another profession? See the complete
    <a href="/prc-board-exam-schedule/">PRC Board Exam Schedule {prcRules.year}</a> — all
    {prcRules.exams.length} licensure exams, searchable, with the same filing windows and result
    targets.{otherExams.length > 0 && (
      <Fragment>
        {' '}Coming up next:{' '}
        {otherExams.map((u) => (
          <Fragment>
            <a href={u.href}>{u.label}</a>{' '}{u.text}{' '}
          </Fragment>
        ))}
      </Fragment>
    )}
  </p>

  <h2>August 2026 PNLE: Rescheduled Sittings and Results</h2>
  <p>
    Two PRC advisories changed the second round for some examinees. On August 28, 2026 PRC
    cancelled the August 29–30 NLE in <strong>Region III</strong> (San Fernando, Pampanga and
    Cabanatuan, Nueva Ecija testing centers) because of regionwide flooding and PAGASA heavy
    rainfall warnings, and on August 30 it set the new Region III dates at
    <strong>September 11–12, 2026</strong>. The same day PRC cancelled the <strong>second exam
    day (August 30) in all Metro Manila testing centers</strong> and rescheduled it to
    <strong>September 12, 2026</strong>. Examinees in every other testing center took the exam on
    the original dates.
  </p>
  <p>
    The make-up sittings did not delay the results. PRC released the
    <strong>August–September 2026 NLE results on {released}</strong> — the target date printed in
    the resolution, five working days after the last sitting: <strong>28,652 of 37,359 examinees
    passed (76.69%)</strong> across 26 testing centers, with 21 results withheld pending PRC’s
    determination of the examinees’ liabilities. Online registration for the new nurses’
    Professional ID and Certificate of Registration opens on <strong>October 13, 2026</strong>
    through LERIS; the oath-taking date and venue are still to be announced on
    <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">prc.gov.ph</a>.
  </p>

  <h2>How to Apply for the PNLE (LERIS)</h2>
  <ol>
    <li>Create or log in to your account on <strong>LERIS</strong>, PRC's Licensure Examination and Registration Information System, at <a href="https://online.prc.gov.ph/" target="_blank" rel="noopener">online.prc.gov.ph</a>.</li>
    <li>Select the <strong>Nurses</strong> licensure examination and your preferred exam center.</li>
    <li>Upload your documents and ID photo, then pay the examination fee through the available payment channels.</li>
    <li>Book an appointment and submit your requirements at your chosen PRC office before the deadline.</li>
    <li>File <strong>within the application window</strong> shown above — late applications are not accepted except in justifiable cases defined by PRC rules.</li>
  </ol>

  <h2>PNLE Results {prcRules.year}: When and Where They Come Out</h2>
  <p>
    PRC's target release dates were <strong>{fmt(first.results_target)}</strong> for the
    {first.dates_display} exam and <strong>{fmt(second.results_target)}</strong> for the
    {second.dates_display} exam. Both came out in five working days: the February round on
    <strong>{firstReleased}</strong> (3,611 of 8,162 passed, 44.24%) and the August–September round
    on <strong>{released}</strong> (28,652 of 37,359 passed, 76.69%). Targets are printed in the
    resolution as an upper bound — the actual release is announced only by PRC. AyTool does not
    host exam results or lists of passers; see how the PNLE compares with every other {prcRules.year} board exam on the
    <a href="/board-exam-results-2026/">PRC Board Exam Results {prcRules.year}</a> page.
  </p>
  <h3>Where the results are published</h3>
  <ol>
    <li><strong>prc.gov.ph</strong> — the official list of passers (alphabetical) and the top 10, posted as a news release on <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">prc.gov.ph</a> and on PRC's official Facebook page.</li>
    <li><strong>Verification of Rating</strong> — your own scores per subject, through LERIS at <a href="https://online.prc.gov.ph/" target="_blank" rel="noopener">online.prc.gov.ph</a> once PRC opens the verification service for that exam.</li>
    <li>News sites and review centers republish the list within hours; treat anything not on prc.gov.ph as unofficial.</li>
  </ol>
  <h3>Passing score</h3>
  <p>
    Under RA 9173 you pass with a <strong>general average of at least 75%</strong> and
    <strong>no subject rated below 60%</strong>. A general average of 75% or higher with one
    subject below 60% is a conditional result — PRC will indicate the subject to be retaken.
  </p>
  <h3>After you pass</h3>
  <ol>
    <li>Register through LERIS once PRC opens <strong>online initial registration</strong> for the new nurses — for the August–September 2026 passers it opens on October 13, 2026; bring the system-generated registration form and a valid government ID to your appointment.</li>
    <li>Attend the <strong>oath-taking</strong> organised by PRC and the Board of Nursing (dates are announced with the results).</li>
    <li>Claim your professional ID and certificate of registration at the PRC office named in your appointment.</li>
  </ol>

  <h2>PNLE Results History {historyFrom}–{historyTo}: Pass Rates, Exam Months and Release Speed</h2>
  <p>
    Every row below is taken from PRC’s press release for that round. The PNLE was a May/November
    exam through 2025 — except 2020, when both rounds were postponed for COVID-19 and never held,
    and 2021, when the first round moved to July — and became a February/August exam in
    {prcRules.year} under Resolution No. 2113, s. 2025. Pass rates have ranged from
    <strong>{pct(lowest.pass_rate)}</strong> ({lowest.round}) to <strong>{pct(highest.pass_rate)}</strong>
    ({highest.round}); the larger November cohorts have posted the higher rates. Results have come
    out {Math.min(...workingDays)} to {Math.max(...workingDays)} working days after the exam, and
    both {prcRules.year} rounds took five.
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Round</th>
          <th>Exam dates</th>
          <th>Results released</th>
          <th>Examinees</th>
          <th>Passers</th>
          <th>Pass rate</th>
        </tr>
      </thead>
      <tbody>
        {
          historyRounds.map((r) => (
            <tr>
              <td>
                <a href={r.source_url} target="_blank" rel="noopener">{r.round}</a>
                {r.verified_via === 'archive' && <sup title="PRC page now offline; text confirmed from the Internet Archive">*</sup>}
              </td>
              <td>
                {r.exam_dates_display}
                {r.note && <span class="text-ink-soft"> — {r.note}</span>}
              </td>
              <td>
                {r.results_released
                  ? `${fmt(r.results_released)} (${r.working_days_to_results} working days)`
                  : '—'}
              </td>
              <td>{num(r.examinees)}</td>
              <td>{num(r.passers)}</td>
              <td>{r.pass_rate === null ? '—' : <strong>{pct(r.pass_rate)}</strong>}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p class="text-sm text-ink-soft">
    Counts are as printed by PRC; the pass rate is passers ÷ examinees. * PRC’s page for that round
