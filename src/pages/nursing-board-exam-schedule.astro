---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import prcRules from '../data/prc/2026.json';
import { PRC_PROFESSIONS, resolveGroup, scheduleSentence } from '../lib/prcProfessions';
import type { PrcExamEntry } from '../lib/rules/types';
import { SITE } from '../../site.config';

const meta = prcRules.meta;
const byName = new Map((prcRules.exams as PrcExamEntry[]).map((e) => [e.exam, e]));
const nursing = PRC_PROFESSIONS.find((g) => g.id === 'nursing');
if (!nursing) throw new Error('PRC_PROFESSIONS no longer has a "nursing" group.');
const rounds = resolveGroup(nursing, byName, prcRules.year);
const [first, second] = rounds;

/* Every date on this page comes from the PRC rule JSON — next year's
   resolution updates the copy without anyone re-typing a date. */
const fmt = (d: string | null | undefined): string =>
  d
    ? new Date(d + 'T00:00:00').toLocaleDateString('en-PH', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
      })
    : 'to be announced';

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Nursing Board Exam Schedule 2026 (PNLE)',
  description: `PNLE ${prcRules.year} schedule per PRC Resolution No. 2113, s. 2025: exam dates, application windows and target result dates for both rounds.`,
  url: `${SITE.url}/nursing-board-exam-schedule/`,
  creator: { '@type': 'Organization', name: 'Professional Regulation Commission (source data)' },
  isBasedOn: meta.official_source_url,
  dateModified: meta.last_verified,
  keywords: ['PNLE', 'nursing board exam schedule 2026', 'PRC', 'Philippines'],
  distribution: [
    {
      '@type': 'DataDownload',
      encodingFormat: 'application/json',
      contentUrl: `${SITE.url}/data/prc-board-exam-schedule-2026.json`,
    },
  ],
  temporalCoverage: `${meta.effective_from}/${meta.effective_to}`,
  spatialCoverage: { '@type': 'Place', name: 'Philippines' },
  isPartOf: `${SITE.url}/prc-board-exam-schedule/`,
};

const faqs = [
  {
    q: 'When is the nursing board exam in 2026?',
    a: `The Philippine Nurse Licensure Examination (PNLE) has two rounds in 2026: ${scheduleSentence(rounds)} Both rounds run for two days each.`,
  },
  {
    q: 'When will the PNLE August 2026 results be released?',
    a: `PRC's target release date for the ${second.dates_display} exam is ${fmt(second.results_target)}. That is the target printed in Resolution No. 2113, s. 2025 — not a guarantee; the actual release is announced on prc.gov.ph.`,
  },
  {
    q: 'How do I apply for the PNLE?',
    a: 'File online through LERIS (online.prc.gov.ph) within the application window: create or log in to your account, choose the Nurses licensure examination, upload your documents, pay the fee, and book an appointment at your chosen PRC office. Applications after the deadline are not accepted except in justifiable cases defined by PRC rules.',
  },
  {
    q: 'How many times a year is the PNLE given?',
    a: `Twice. In ${prcRules.year} the rounds are ${first.dates_display} and ${second.dates_display}, so a candidate who misses the first filing window can target the second round.`,
  },
  {
    q: 'What happens if I fail the PNLE three times?',
    a: 'Under the Philippine Nursing Act of 2002 (RA 9173), an examinee who fails the nurse licensure examination three consecutive times must complete a refresher course before being allowed to retake the exam.',
  },
  {
    q: 'Was the August 2026 PNLE rescheduled?',
    a: 'Partly. PRC cancelled the August 29–30, 2026 NLE in Region III (San Fernando, Pampanga and Cabanatuan, Nueva Ecija testing centers) because of regionwide flooding and moved it to September 11–12, 2026, and cancelled the second exam day (August 30) in all Metro Manila testing centers because of PAGASA heavy-rainfall warnings, moving it to September 12, 2026. Other testing centers took the exam as scheduled. As of mid-September 2026 PRC had not announced a new results date; the resolution’s target remains September 18, 2026.',
  },
  {
    q: 'When is the PNLE 2027 schedule release date?',
    a: 'PRC publishes the whole following-year calendar in one resolution, usually signed in late October and posted on prc.gov.ph in mid-November — the 2026 schedule (Resolution No. 2113, s. 2025) was signed on October 23, 2025 and posted on November 17, 2025. Expect the PNLE 2027 dates around November 2026. This page switches to the 2027 schedule as soon as it is out.',
  },
  {
    q: 'Is there a February 2027 PNLE?',
    a: 'Not confirmed. The 2026 calendar moved the PNLE to February and August, and review centers are enrolling for a February 2027 round on that assumption, but PRC has not released the 2027 resolution, and there is unconfirmed talk online that the exam could return to the old May/November cycle. Treat any 2027 date as unofficial until it appears on prc.gov.ph.',
  },
  {
    q: 'What are the requirements for the nursing board exam?',
    a: 'Under RA 9173, Sec. 13 you must be a Filipino citizen (or a citizen of a country that lets Filipino nurses practise there on reciprocity), of good moral character, and a holder of a Bachelor of Science in Nursing degree from a CHED-recognised college or university. When filing in LERIS, PRC asks for your transcript of records with scanned picture and the remark “For Board Examination Purposes”, a PSA birth certificate, a PSA marriage certificate if you file under a married name, and the examination fee; PRC lists the exact set for the current round inside LERIS.',
  },
  {
    q: 'Is this schedule official?',
    a: 'The dates are transcribed from PRC Resolution No. 2113, s. 2025 — the official Schedule of Licensure Examinations for 2026. Always confirm on prc.gov.ph before booking travel or review classes; PRC can move dates by later resolution.',
  },
  {
    q: 'Kailan ang PNLE 2026?',
    a: `The Philippine Nurse Licensure Examination has two rounds in ${prcRules.year}: ${scheduleSentence(rounds)} Each round is a two-day exam.`,
  },
  {
    q: 'Kailan lalabas ang result ng PNLE 2026?',
    a: `PRC targets ${fmt(first.results_target)} for the ${first.dates_display} exam and ${fmt(second.results_target)} for the ${second.dates_display} exam (Resolution No. 2113, s. 2025). These are targets, not guarantees — the actual release is announced on prc.gov.ph.`,
  },
];
---

<ToolPageLayout
  title="PNLE 2026 Schedule – Nursing Board Exam Dates & Results Date"
  description={`PNLE ${prcRules.year} schedule: ${first.dates_display} and ${second.dates_display}, with application deadlines, LERIS filing steps and PRC's target result dates.`}
  path="/nursing-board-exam-schedule/"
  h1="Nursing Board Exam Schedule 2026 (PNLE)"
  faqs={faqs}
  related={['prc', 'takeHome', 'thirteenth', 'sssCalculator']}
  isApp={false}
  extraSchema={[datasetSchema]}
>
  <Fragment slot="answer">
    <p>
      The <strong>Philippine Nurse Licensure Examination (PNLE)</strong> is given twice in
      {prcRules.year}: <strong>{first.dates_display}</strong> (filing {fmt(first.application_start)}
      to {fmt(first.application_deadline)}) and <strong>{second.dates_display}</strong> (filing
      {fmt(second.application_start)} to {fmt(second.application_deadline)}), per PRC Resolution
      No. 2113, s. 2025. Target result dates: {fmt(first.results_target)} and
      {fmt(second.results_target)}. <strong>Update:</strong> the August round was partly
      rescheduled — Region III moved to September 11–12 and Metro Manila’s second exam day to
      September 12, 2026 because of flooding (details below).
    </p>
  </Fragment>

  <h2>PNLE {prcRules.year} Exam Dates and Deadlines</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Round</th>
          <th>Exam dates</th>
          <th>Application window</th>
          <th>Results (target)</th>
        </tr>
      </thead>
      <tbody>
        {
          rounds.map((r, i) => (
            <tr>
              <td>{i + 1}</td>
              <td>
                <strong>{r.dates_display}</strong>
              </td>
              <td>
                {fmt(r.application_start)} – {fmt(r.application_deadline)}
              </td>
              <td>{fmt(r.results_target)}</td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  <p>
    Looking for another profession? See the complete
    <a href="/prc-board-exam-schedule/">PRC Board Exam Schedule {prcRules.year}</a> — all
    {prcRules.exams.length} licensure exams, searchable, with the same filing windows and result
    targets.
  </p>

  <h2>August 2026 PNLE Rescheduled: Region III and Metro Manila</h2>
  <p>
    Two PRC advisories changed the second round for some examinees. On August 28, 2026 PRC
    cancelled the August 29–30 NLE in <strong>Region III</strong> (San Fernando, Pampanga and
    Cabanatuan, Nueva Ecija testing centers) because of regionwide flooding and PAGASA heavy
    rainfall warnings, and on August 30 it set the new Region III dates at
    <strong>September 11–12, 2026</strong>. The same day PRC cancelled the <strong>second exam
    day (August 30) in all Metro Manila testing centers</strong> and rescheduled it to
    <strong>September 12, 2026</strong>. Examinees in every other testing center took the exam on
    the original dates.
  </p>
  <p>
    As of mid-September 2026 PRC has not published a new target release date for the results. The
    resolution’s target stays {fmt(second.results_target)}; PRC normally releases one list of
    passers for the whole round, so the September 12 sittings may push the actual release past
    that target. Watch <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">prc.gov.ph</a>
    for the announcement.
  </p>

  <h2>How to Apply for the PNLE (LERIS)</h2>
  <ol>
    <li>Create or log in to your account on <strong>LERIS</strong>, PRC's Licensure Examination and Registration Information System, at <a href="https://online.prc.gov.ph/" target="_blank" rel="noopener">online.prc.gov.ph</a>.</li>
    <li>Select the <strong>Nurses</strong> licensure examination and your preferred exam center.</li>
    <li>Upload your documents and ID photo, then pay the examination fee through the available payment channels.</li>
    <li>Book an appointment and submit your requirements at your chosen PRC office before the deadline.</li>
    <li>File <strong>within the application window</strong> shown above — late applications are not accepted except in justifiable cases defined by PRC rules.</li>
  </ol>

  <h2>PNLE Results {prcRules.year}: When and Where They Come Out</h2>
  <p>
    PRC's target release dates are <strong>{fmt(first.results_target)}</strong> for the
    {first.dates_display} exam and <strong>{fmt(second.results_target)}</strong> for the
    {second.dates_display} exam. These are the targets printed in the resolution — the actual
    release can land a few days either side and is announced only by PRC. AyTool does not host
    exam results or lists of passers.
  </p>
  <h3>Where the results are published</h3>
  <ol>
    <li><strong>prc.gov.ph</strong> — the official list of passers (alphabetical) and the top 10, posted as a news release on <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">prc.gov.ph</a> and on PRC's official Facebook page.</li>
    <li><strong>Verification of Rating</strong> — your own scores per subject, through LERIS at <a href="https://online.prc.gov.ph/" target="_blank" rel="noopener">online.prc.gov.ph</a> once PRC opens the verification service for that exam.</li>
    <li>News sites and review centers republish the list within hours; treat anything not on prc.gov.ph as unofficial.</li>
  </ol>
  <h3>Passing score</h3>
  <p>
    Under RA 9173 you pass with a <strong>general average of at least 75%</strong> and
    <strong>no subject rated below 60%</strong>. A general average of 75% or higher with one
    subject below 60% is a conditional result — PRC will indicate the subject to be retaken.
  </p>
  <h3>After you pass</h3>
  <ol>
    <li>Watch for PRC's announcement of the <strong>online initial registration</strong> schedule for the new nurses; book your appointment through LERIS.</li>
    <li>Attend the <strong>oath-taking</strong> organised by PRC and the Board of Nursing (dates are announced with the results).</li>
    <li>Claim your professional ID and certificate of registration at the PRC office named in your appointment.</li>
  </ol>

  <h2>PNLE 2027 Schedule: What Is Known So Far</h2>
  <p>
    PRC has <strong>not yet released the 2027 schedule</strong>. It publishes the whole
    following-year calendar in one resolution, usually signed in late October and posted on
    prc.gov.ph in mid-November — the 2026 schedule (Resolution No. 2113, s. 2025) was signed on
    October 23, 2025 and posted on November 17, 2025 — so the PNLE 2027 schedule release date is
    most likely November 2026. Until then, every 2027 date circulating is unofficial:
  </p>
  <ul>
    <li><strong>February/August pattern:</strong> 2026 moved the PNLE from the old May/November cycle to February and August. Many review centers are enrolling for a “PNLE February 2027” round on the assumption that the pattern continues.</li>
    <li><strong>Talk of reverting:</strong> there is unconfirmed discussion online that PRC could return the exam to May and November in 2027. PRC has not said so.</li>
    <li><strong>Filing window:</strong> PRC opened 2026 filing about three months before each exam and closed it four to six weeks before, so a late-February 2027 round would file from roughly late November 2026 to mid-January 2027.</li>
  </ul>
  <p>
    This page switches to the official 2027 dates the day PRC publishes them; the
    <a href="/prc-board-exam-schedule/">PRC Board Exam Schedule</a> page does the same for every
    other profession.
  </p>

  <h2>Retakes</h2>
  <p>
    Under the Philippine Nursing Act of 2002 (RA 9173), an examinee who fails the PNLE three
    consecutive times must complete a refresher course before retaking the exam. Since the PNLE is
    offered twice a year, the next chance after a failed round is normally about six months later.
  </p>

  <h2>Official Source</h2>
  <p>
    <a href={meta.official_source_url} target="_blank" rel="noopener">{meta.official_source_label}</a>
    — Resolution No. 2113, Series of 2025, signed October 23, 2025. Last verified
    {new Date(meta.last_verified + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' })}.
    Apply, verify results and process your license only on the official
    <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">PRC website</a> and LERIS
    portal — AyTool is independent, does not host exam results, and cannot process applications.
  </p>
</ToolPageLayout>
