---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import PrcScheduleTable from '../islands/PrcScheduleTable';
import PrcProfessionSections from '../components/PrcProfessionSections.astro';
import prcRules from '../data/prc/2026.json';
import { PRC_PROFESSIONS, resolveGroup, scheduleSentence } from '../lib/prcProfessions';
import type { PrcExamEntry } from '../lib/rules/types';
import { SITE } from '../../site.config';

const meta = prcRules.meta;

/* FAQ dates are generated from the rule data, so next year's PRC resolution
   updates these answers without anyone re-typing a date. */
const byName = new Map((prcRules.exams as PrcExamEntry[]).map((e) => [e.exam, e]));
function sched(id: string): string {
  const group = PRC_PROFESSIONS.find((g) => g.id === id);
  if (!group) throw new Error(`FAQ references unknown PRC profession id "${id}".`);
  return scheduleSentence(resolveGroup(group, byName, prcRules.year));
}
const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'PRC Board Exam Schedule 2026',
  description:
    'Schedule of Philippine licensure examinations for 2026 per PRC Resolution No. 2113, s. 2025: exam dates, application windows and target result dates.',
  url: `${SITE.url}/prc-board-exam-schedule/`,
  creator: { '@type': 'Organization', name: 'Professional Regulation Commission (source data)' },
  isBasedOn: meta.official_source_url,
  dateModified: meta.last_verified,
};
const faqs = [
  {
    q: 'When is the nursing board exam (PNLE) in 2026?',
    a: `The Philippine Nurse Licensure Examination has two rounds in 2026: ${sched('nursing')} The PNLE is given twice a year, so a candidate who misses the first filing window can target the second round.`,
  },
  {
    q: 'When is the LET (teachers board exam) in 2026?',
    a: `The Professional Teachers licensure examination (LET / BLEPT) is scheduled for ${sched('teachers-let')} Both rounds fall on a Sunday and are administered nationwide.`,
  },
  {
    q: 'When is the criminology board exam in 2026?',
    a: `The Criminologist Licensure Examination runs ${sched('criminology')} It is given twice in 2026, in February and August.`,
  },
  {
    q: 'When is the CPA board exam (CPALE) in 2026?',
    a: `The Certified Public Accountant Licensure Examination is scheduled for ${sched('accountancy')} CPALE is given twice in 2026, in May and October.`,
  },
  {
    q: 'When is the civil engineering board exam in 2026?',
    a: `The Civil Engineer Licensure Examination is scheduled for ${sched('civil-engineering')} It is offered twice in 2026, in March and September.`,
  },
  {
    q: 'When is the med tech board exam (MTLE) in 2026?',
    a: `The Medical Technologist Licensure Examination is scheduled for ${sched('medical-technology')} It is offered twice in 2026, in March and August.`,
  },
  {
    q: 'When is the physician licensure exam (PLE) in 2026?',
    a: `The Physician Licensure Examination is scheduled for ${sched('physicians')} Each PLE round is split across two weekends.`,
  },
  {
    q: 'How do I apply for a PRC board exam?',
    a: 'File online through LERIS (the PRC Licensure Examination and Registration Information System) at online.prc.gov.ph within the application window, upload your documents, pay the fee, and book your appointment. Applications after the deadline are not accepted except in justifiable cases defined by PRC rules.',
  },
  {
    q: 'Are the result dates in this table official?',
    a: 'They are the target release dates printed in PRC Resolution No. 2113, s. 2025. PRC describes them as targets, not guarantees — actual release can move. Always check prc.gov.ph for the official results announcement.',
  },
  {
    q: 'When will PRC release the schedule of exam for 2027?',
    a: 'PRC publishes the following year\'s schedule of examination in a single resolution, usually signed in late October and posted on prc.gov.ph in mid-November. The 2026 schedule (Resolution No. 2113, s. 2025) was signed on October 23, 2025 and published on November 17, 2025, so the 2027 schedule of exam is expected around November 2026. This page is updated as soon as PRC releases it.',
  },
  {
    q: 'Kailan ang board exam ng nursing sa 2026?',
    a: `The PNLE has two rounds in 2026: ${sched('nursing')} Filing is online through LERIS within the application window shown in the table above.`,
  },
  {
    q: 'Paano mag-apply sa PRC board exam online?',
    a: 'Go to online.prc.gov.ph (LERIS), create or log in to your account, select the licensure examination, upload your documents, pay the fee and book an appointment at your chosen PRC office within the application window. Late applications are not accepted except in justifiable cases defined by PRC rules.',
  },
];
---

<ToolPageLayout
  title="PRC Board Exam Schedule 2026 – Complete Dates & Deadlines"
  description="Complete 2026 PRC board exam schedule: dates, application deadlines and target results for all 88 licensure exams. Searchable and filterable."
  path="/prc-board-exam-schedule/"
  h1="PRC Board Exam Schedule 2026"
  updated="August 2026"
  faqs={faqs}
  related={['nursingSchedule', 'oec', 'takeHome', 'sssTable']}
  isApp={false}
  extraSchema={[datasetSchema]}
>
  <Fragment slot="answer">
    <p>
      The official 2026 PRC schedule of examination is set by <strong>PRC Resolution No. 2113, s.
      2025</strong>, covering {prcRules.exams.length} scheduled licensure examinations — from the
      Nursing exam on February 26–27 and the LET on March 15 &amp; September 20, to the CPA exams
      in May and October. Search or filter the complete schedule below, including application
      windows and target result dates, or jump to the
      <a href="#by-profession">schedule for your own profession</a>.
    </p>
  </Fragment>

  <Fragment slot="calculator">
    <PrcScheduleTable client:idle />
  </Fragment>

  <PrcProfessionSections />

  <h2>How to Use This Schedule</h2>
  <ul>
    <li><strong>Application window:</strong> file through PRC's LERIS portal between the opening date and the deadline. Deadlines falling on weekends or holidays move to the next working day.</li>
    <li><strong>Exam dates:</strong> multi-day entries mean the exam spans several days; "CBLE" marks computer-based licensure examinations.</li>
    <li><strong>Results (target):</strong> the target release dates printed in the resolution — actual releases are announced on prc.gov.ph.</li>
    <li><strong>SPLE:</strong> Special Professional Licensure Examinations for OFWs abroad are scheduled by separate PRC issuances and are not in this table.</li>
    <li><strong>Marine officers:</strong> Marine Deck/Engine licensure moved from PRC to MARINA in 2014 and is not part of the PRC calendar.</li>
  </ul>

  <h2>PRC Schedule of Exam 2026: Release Date and the 2027 Calendar</h2>
  <p>
    PRC releases its schedule of examination once a year, in a single resolution covering every
    licensure exam. The 2026 schedule of exam was signed as Resolution No. 2113 on October 23, 2025
    and published on prc.gov.ph on November 17, 2025. The 2027 schedule is expected on the same
    cycle — a resolution in late October 2026, posted in mid-November 2026 — and this page will
    switch to the 2027 dates as soon as it is out. Until then, the 2026 dates above are the working
    reference: each profession usually keeps the same month of the year from one calendar to the
    next. PRC can still move individual exams mid-year through separate resolutions, so the table
    reflects the schedule in force as of the verification date below.
  </p>

  <h2>Official Source</h2>
  <p>
    <a href={meta.official_source_url} target="_blank" rel="noopener">{meta.official_source_label}</a>
    — Resolution No. 2113, Series of 2025, signed October 23, 2025. Last verified
    {new Date(meta.last_verified + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' })}.
    Apply, verify results and process your license only on the official
    <a href="https://www.prc.gov.ph/" target="_blank" rel="noopener">PRC website</a> and LERIS
    portal — AyTool is independent, does not host exam results, and cannot process applications.
  </p>
</ToolPageLayout>
