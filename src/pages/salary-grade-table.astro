---
/**
 * Government salary grades under EO No. 64, s. 2024. The tranche shown is the
 * one in force on the Philippine date (todayInManila), so the nightly rebuild
 * switches the page to the 2027 tranche on January 1, 2027.
 */
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import SalaryGradeCalculator from '../islands/SalaryGradeCalculator';
import sslJson from '../data/ssl/2026.json';
import taxJson from '../data/tax/2026.json';
import philhealthJson from '../data/philhealth/2026.json';
import pagibigJson from '../data/pagibig/2026.json';
import type { PagibigRules, PhilhealthRules, SslRules, TaxRules } from '../lib/rules/types';
import { governmentNetPay, monthlySalary, nextTranche, trancheAsOf, trancheForYear } from '../lib/engine/ssl';
import { todayInManila } from '../lib/today.mjs';
import { peso } from '../lib/format';

const ssl = sslJson as unknown as SslRules;
const deps = { tax: taxJson as unknown as TaxRules, philhealth: philhealthJson as unknown as PhilhealthRules, pagibig: pagibigJson as unknown as PagibigRules };
const today = todayInManila();
const cur = trancheAsOf(ssl, today);
const next = nextTranche(ssl, today);
const prev = trancheForYear(ssl, cur.year - 1);
const Y = cur.year;
const s = (t: typeof cur, g: number, st = 1) => monthlySalary(t, g, st)!;
const grades = Array.from({ length: 33 }, (_, i) => i + 1);
const steps = [1, 2, 3, 4, 5, 6, 7, 8];
const pos = (title: string) => ssl.positions.find((p) => p.title === title)!;
const teacher = pos('Teacher I');
const nurse = pos('Nurse I');
const net11 = governmentNetPay(s(cur, 11), ssl, deps);
const peraAmt = ssl.allowances.find((a) => a.key === 'pera')!.amount;
const pctUp = (a: number, b: number) => `${(((a - b) / b) * 100).toFixed(2)}%`;

const faqs = [
  {
    q: `What is the salary of Salary Grade 11 in ${Y}?`,
    a: `${peso(s(cur, 11))} a month at Step 1, rising to ${peso(s(cur, 11, 8))} at Step 8, under the ${Y} tranche of ${ssl.order}.${next ? ` From January 1, ${next.year} it becomes ${peso(s(next, 11))} (Step 1).` : ''} SG 11 is the grade of a Teacher I.`,
  },
  {
    q: `How much is a Teacher I salary in ${Y}?`,
    a: `Teacher I is Salary Grade ${teacher.sg} (DBM Index of Occupational Services), so a newly hired Teacher I receives ${peso(s(cur, teacher.sg))} a month in ${Y}${next ? ` and ${peso(s(next, teacher.sg))} from January 1, ${next.year}` : ''}. After GSIS, PhilHealth, Pag-IBIG and withholding tax the monthly net basic pay is about ${peso(net11.netBasic)}, plus ${peraAmt.replace(' a month', '')} PERA a month and the ₱10,000 yearly teaching allowance for public school teachers (RA 11997).`,
  },
  {
    q: `How much is the salary of a Nurse I in government in ${Y}?`,
    a: `Nurse I is Salary Grade ${nurse.sg}: ${peso(s(cur, nurse.sg))} a month at Step 1 in ${Y}, up to ${peso(s(cur, nurse.sg, 8))} at Step 8${next ? `; ${peso(s(next, nurse.sg))} at Step 1 from January 1, ${next.year}` : ''}.`,
  },
  {
    q: `What is the lowest and highest government salary in ${Y}?`,
    a: `Salary Grade 1, Step 1 is ${peso(s(cur, 1))} a month; the top of the schedule, SG 33 Step 2, is ${peso(s(cur, 33, 2))}. SG 33 has only two steps; every other grade has eight.`,
  },
  {
    q: 'When is the next salary increase for government employees?',
    a: next
      ? `January 1, ${next.year} — the ${next.tranche} tranche of ${ssl.order}. Salary Grade 1 rises to ${peso(s(next, 1))} and SG 11 to ${peso(s(next, 11))}. DBM implements each tranche with a National Budget Circular, usually issued in January.`
      : `${ssl.order} ended with the tranche of January 1, ${Y}. A further increase needs a new law or executive order; check DBM announcements.`,
  },
  {
    q: 'Do new hires start at Step 1?',
    a: `${ssl.rules.new_hires} ${ssl.rules.incumbents}`,
  },
  {
    q: 'Do local government (LGU) employees get the same salary?',
    a: ssl.rules.lgu,
  },
  {
    q: 'Are police and soldiers on this salary grade table?',
    a: ssl.rules.excluded,
  },
  {
    q: `How much are the PERA, bonuses and other allowances in ${Y}?`,
    a: ssl.allowances.filter((a) => a.key !== 'teaching').map((a) => `${a.name}: ${a.amount}`).join('; ') + '. Each has eligibility rules in the General Appropriations Act; see the table on this page.',
  },
  {
    q: `Magkano ang sahod ng Salary Grade 1 ngayong ${Y}?`,
    a: `${peso(s(cur, 1))} kada buwan sa Step 1 at ${peso(s(cur, 1, 8))} sa Step 8${next ? `; magiging ${peso(s(next, 1))} simula Enero 1, ${next.year}` : ''}. May dagdag na ${peso(2000)} PERA kada buwan, mid-year bonus tuwing Mayo, at year-end bonus kasama ang ${peso(5000)} cash gift tuwing Nobyembre.`,
  },
];
---

<ToolPageLayout
  title={`Salary Grade Table ${Y} – Government Salary (EO 64, SSL)`}
  description={`Salary grades 1–33, Steps 1–8, for ${Y} under EO No. 64: SG 1 ${peso(s(cur, 1))}, Teacher I (SG 11) ${peso(s(cur, 11))}, Nurse I (SG 15) ${peso(s(cur, 15))}${next ? `, and the ${next.year} rates` : ''}.`}
  path="/salary-grade-table/"
  h1={`Salary Grade Table ${Y} for Government Employees`}
  faqs={faqs}
  related={['incomeTax', 'takeHome', 'pagibigLoan', 'thirteenth']}
>
  <Fragment slot="answer">
    <p>
      Under <strong>{ssl.order}</strong>, civilian government employees earn from <strong>{peso(s(cur, 1))}</strong> a month
      (Salary Grade 1, Step 1) to {peso(s(cur, 33, 2))} (SG 33, Step 2) in {Y}. A <strong>Teacher I (SG 11)</strong> starts at
      {' '}<strong>{peso(s(cur, 11))}</strong> and a <strong>Nurse I (SG 15)</strong> at {peso(s(cur, 15))}.
      {next && <Fragment> The final tranche takes effect on <strong>January 1, {next.year}</strong>: SG 1 becomes {peso(s(next, 1))} and SG 11 {peso(s(next, 11))}.</Fragment>}
      {' '}On top of the basic salary: {peraAmt.replace(' a month', '')} PERA a month, a mid-year and a year-end bonus of one month each, and a ₱5,000 cash gift.
    </p>
  </Fragment>

  <Fragment slot="calculator">
    <SalaryGradeCalculator client:idle />
  </Fragment>

  <h2>Salary Grade Table {Y} (Monthly, Steps 1–8)</h2>
  <p class="text-sm text-ink-soft">
    {cur.tranche.charAt(0).toUpperCase() + cur.tranche.slice(1)} tranche of {ssl.order}, in force since January 1, {Y}
    {cur.issuance && <Fragment>; implemented by <a href={cur.issuance_url!} target="_blank" rel="noopener">{cur.issuance}</a></Fragment>}.
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>SG</th>{steps.map((n) => <th>Step {n}</th>)}</tr></thead>
      <tbody>
        {grades.map((g) => (
          <tr>
            <td><strong>{g}</strong></td>
            {steps.map((n) => <td>{monthlySalary(cur, g, n) !== null ? peso(monthlySalary(cur, g, n)!) : '—'}</td>)}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Step 1 Salary by Year{prev ? ` (${prev.year}–${next ? next.year : Y})` : ''}</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>SG</th>{prev && <th>{prev.year}</th>}<th>{Y}</th>{next && <th>{next.year}</th>}{next && <th>Increase</th>}</tr>
      </thead>
      <tbody>
        {grades.map((g) => (
          <tr>
            <td><strong>{g}</strong></td>
            {prev && <td>{peso(s(prev, g))}</td>}
            <td><strong>{peso(s(cur, g))}</strong></td>
            {next && <td>{peso(s(next, g))}</td>}
            {next && <td>{pctUp(s(next, g), s(cur, g))}</td>}
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Salary Grades of Common Positions</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Position</th><th>SG</th><th>{Y}, Step 1</th>{next && <th>{next.year}, Step 1</th>}</tr></thead>
      <tbody>
        {ssl.positions.map((p) => (
          <tr><td>{p.title}</td><td>{p.sg}</td><td>{peso(s(cur, p.sg))}</td>{next && <td>{peso(s(next, p.sg))}</td>}</tr>
        ))}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-ink-soft">
    Grades from the DBM Index of Occupational Services (2022 edition). An agency's plantilla can differ for a specific item;
    your appointment paper shows your grade and step.
  </p>

  <h2>Allowances and Bonuses ({Y})</h2>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Benefit</th><th>Amount</th><th>Rule</th></tr></thead>
      <tbody>
        {ssl.allowances.map((a) => (
          <tr><td><strong>{a.name}</strong></td><td>{a.amount}</td><td>{a.rule}</td></tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Deductions: GSIS, PhilHealth, Pag-IBIG and Tax</h2>
  <p>
    Government employees pay {Math.round(ssl.contributions.gsis_personal * 100)}% of their monthly compensation to GSIS (the
    government adds {Math.round(ssl.contributions.gsis_government * 100)}%) under RA 8291, PhilHealth's 5% premium split equally
    with the employer, and Pag-IBIG's ₱200, before withholding tax on the rest — a Teacher I on {peso(s(cur, 11))} nets about
    {' '}{peso(net11.netBasic)} of basic pay. {ssl.contributions.caveat} The <a href="/income-tax-calculator/">Income Tax
    Calculator</a> shows the tax tables and how bonuses above ₱90,000 are taxed.
  </p>

  <h2>Rules That Decide Your Salary</h2>
  <ul>
    <li><strong>New hires:</strong> {ssl.rules.new_hires}</li>
    <li><strong>Incumbents:</strong> {ssl.rules.incumbents}</li>
    <li><strong>Casual employees:</strong> {ssl.rules.casual}</li>
    <li><strong>Local governments:</strong> {ssl.rules.lgu}</li>
    <li><strong>Not covered:</strong> {ssl.rules.excluded}</li>
  </ul>

  <h2>Official Sources</h2>
  <ul>
    <li><a href={ssl.order_url} target="_blank" rel="noopener">{ssl.order}</a> — salary schedules for 2024 to 2027 (Sec. 3) and tranche dates (Sec. 5)</li>
    {ssl.tranches.filter((t) => t.issuance).map((t) => <li><a href={t.issuance_url!} target="_blank" rel="noopener">{t.issuance}</a> — {t.year} tranche</li>)}
    <li><a href="https://www.dbm.gov.ph/wp-content/uploads/GAA/GAA2026/VolumeIB/GENPRO.pdf" target="_blank" rel="noopener">FY 2026 General Appropriations Act (RA 12314), General Provisions</a> — PERA, clothing allowance, bonuses, medical allowance</li>
    <li><a href={ssl.contributions.source_url} target="_blank" rel="noopener">RA 8291 (GSIS Act of 1997)</a> — contribution rates</li>
  </ul>
  <p class="text-sm text-ink-soft">{ssl.source_note} AyTool is independent and not affiliated with DBM or GSIS.</p>
</ToolPageLayout>
