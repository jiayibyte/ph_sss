---
/**
 * Minimum wage by region. Every figure comes from src/data/wages/<year>.json.
 * The page is built "as of" the Philippine calendar day (todayInManila): an
 * order or tranche whose effectivity date has arrived is shown as in force, so
 * the nightly server rebuild flips NCR-28 on Sept 26 and the Bicol/BARMM
 * tranches on Dec 1 without anyone editing this file. `today` is only compared,
 * never printed, so the page changes on those days and no others.
 */
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import MinimumWageCalculator from '../islands/MinimumWageCalculator';
import wagesJson from '../data/wages/2026.json';
import type { WageRegion, WageRules } from '../lib/rules/types';
import { describeRates, monthlyEquivalent, ncrInForce, ncrUpcomingInForce, rateRange, wagesAsOf } from '../lib/engine/wages';
import { todayInManila } from '../lib/today.mjs';
import { peso } from '../lib/format';
import { SITE } from '../../site.config';

const rules = wagesJson as unknown as WageRules;
const meta = rules.meta;
const today = todayInManila();
const view = wagesAsOf(rules, today);
const n26 = rules.ncr.in_force;
const n27 = rules.ncr.enjoined;
const n28 = rules.ncr.upcoming;
const live28 = ncrUpcomingInForce(rules, today);
const cur = ncrInForce(rules, today);
const range = rateRange(view);
const fmt = (d: string | null | undefined): string =>
  d ? new Date(d + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' }) : 'to be announced';
const f313 = rules.divisors.options.find((d) => d.id === '313')!.factor;
const f365 = rules.divisors.options.find((d) => d.id === '365')!.factor;
const f261 = rules.divisors.options.find((d) => d.id === '261')!.factor;
const byId = (id: string) => view.regions.find((r) => r.id === id)!;
const top = (id: string) => byId(id).tiers[0]!.rate;
const shortName = (name: string) => name.split(' – ')[1] ?? name;
const examples = [n26.non_agriculture, n28.non_agriculture, top('r3'), top('r7'), top('r11'), top('r6'), 500, top('r4b')];
const withOrder = view.regions.filter((r) => r.tiers.length > 0);
/** A later tranche already in effect (shown next to the order's date); comparisons stay out of the template. */
const trancheInEffect = (r: WageRegion): string | null => {
  const t = r.second_tranche_effectivity;
  return t && t <= today && t !== r.effectivity ? t : null;
};
const upcomingRegions = view.regions.filter((r) => r.upcoming);
const otherTier = 'agriculture, service and retail establishments with 15 or fewer workers, and manufacturing with fewer than 10 workers';

// "Lowest" FAQ: BARMM holds the floor; among one-rate regions, name every region tied at the lowest rate.
const barmm = byId('barmm');
const bicol = byId('r5');
const singleRate = view.regions.filter((r) => r.tiers.length === 1);
const singleLow = Math.min(...singleRate.map((r) => r.tiers[0]!.rate));
const singleLowNames = singleRate.filter((r) => r.tiers[0]!.rate === singleLow).map((r) => shortName(r.name));
const lowestAnswer = [
  `BARMM, at ${peso(range.low)} a day for agriculture outside the cities under Wage Order ${barmm.wage_order} (${peso(barmm.tiers[0]!.rate)} non-agriculture in Cotabato, Lamitan and Marawi)` +
    (barmm.upcoming
      ? `; its second tranche raises these to ${peso(barmm.upcoming.rates.at(-1)!.rate)} and ${peso(barmm.upcoming.rates[0]!.rate)} on ${fmt(barmm.upcoming.effectivity)}.`
      : barmm.second_tranche_effectivity && barmm.second_tranche_effectivity <= today
        ? `, since the ${fmt(barmm.second_tranche_effectivity)} tranche.`
        : '.'),
  `The lowest single-rate ${singleLowNames.length > 1 ? `regions are ${singleLowNames.join(' and ')}` : `region is ${singleLowNames[0]}`} at ${peso(singleLow)}` +
    (bicol.upcoming
      ? `; Bicol rises to ${peso(bicol.upcoming.rates[0]!.rate)} on ${fmt(bicol.upcoming.effectivity)}.`
      : bicol.second_tranche_effectivity && bicol.second_tranche_effectivity <= today
        ? `; Bicol has been ${peso(top('r5'))} since ${fmt(bicol.second_tranche_effectivity)}.`
        : '.'),
  `The highest in force is NCR at ${peso(range.high)}.`,
].join(' ');

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: 'Philippine Regional Daily Minimum Wage Rates 2026',
  description: `Current daily minimum wage by region and sector under the latest Regional Tripartite Wages and Productivity Board wage orders, as summarised by NWPC on ${meta.rule_version.match(/September \d+, 2026/)?.[0] ?? '2026'}.`,
  url: `${SITE.url}/minimum-wage-philippines/`,
  creator: { '@type': 'Organization', name: 'National Wages and Productivity Commission (source data)' },
  isBasedOn: meta.official_source_url,
  dateModified: meta.last_verified,
  keywords: ['minimum wage', 'Philippines', 'NCR', 'wage order', 'daily minimum wage 2026', 'NWPC'],
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE.url}/data/minimum-wage-philippines-2026.json` }],
  spatialCoverage: { '@type': 'Place', name: 'Philippines' },
};

const faqs = [
  {
    q: 'What is the minimum wage in Metro Manila (NCR) in 2026?',
    a: live28
      ? `Since ${fmt(n28.effectivity)} the NCR minimum is ${peso(n28.non_agriculture)} a day for non-agriculture and ${peso(n28.other_tier)} for ${otherTier} (Wage Order NCR-28, a ₱${n28.increase} increase). Before that it was ${peso(n26.non_agriculture)} / ${peso(n26.other_tier)} under Wage Order NCR-26.`
      : `The legally enforceable NCR minimum is ${peso(n26.non_agriculture)} a day for non-agriculture and ${peso(n26.other_tier)} for ${otherTier} (Wage Order NCR-26, in effect since ${fmt(n26.effectivity)}). Wage Order NCR-28 raises these to ${peso(n28.non_agriculture)} and ${peso(n28.other_tier)} on ${fmt(n28.effectivity)}, 15 days after its ${fmt(n28.date_published)} publication.`,
  },
  {
    q: live28 ? 'When did the ₱755 NCR minimum wage take effect?' : 'When does the ₱755 NCR minimum wage take effect?',
    a: `On ${fmt(n28.effectivity)}. Wage Order NCR-28 (₱${n28.increase} increase to ${peso(n28.non_agriculture)} / ${peso(n28.other_tier)}) was approved on ${fmt(n28.date_issued)} and published on ${fmt(n28.date_published)}; its Section 7 makes it effective 15 days after publication, and DOLE announced ${fmt(n28.effectivity)} as the start date. Employers with 10 or fewer retail or service workers may apply for exemption within 75 days of publication.`,
  },
  {
    q: 'What happened to Wage Order NCR-27?',
    a: n27.status + ` NCR-27 (${fmt(n27.date_issued)}) would have set ${peso(n27.non_agriculture)} / ${peso(n27.other_tier)} from ${fmt(n27.nominal_effectivity)}; NCR-28 re-grants the same ₱${n28.increase} increase on the NCR-26 baseline through a fresh order, effective ${fmt(n28.effectivity)}.`,
  },
  {
    q: 'What is the monthly equivalent of the NCR minimum wage?',
    a: `It depends on how you are paid (DOLE Handbook on Workers' Statutory Monetary Benefits, 2024 edition). A daily-paid worker on a six-day week with paid holidays uses factor ${f313}: ${peso(cur.non_agriculture)} × ${f313} ÷ 12 = ${peso(monthlyEquivalent(cur.non_agriculture, f313))} a month${live28 ? '' : ` (${peso(monthlyEquivalent(n28.non_agriculture, f313))} once ${peso(n28.non_agriculture)} takes effect on ${fmt(n28.effectivity)})`}. A monthly-paid employee, paid for every day of the month, uses factor ${f365}: ${peso(monthlyEquivalent(cur.non_agriculture, f365))}. A five-day week uses ${f261}: ${peso(monthlyEquivalent(cur.non_agriculture, f261))}. NWPC itself uses ${f313} in its press releases.`,
  },
  {
    q: 'What is the minimum wage in Cebu, Davao and CALABARZON?',
    a: `Cebu (Region VII, Wage Order ${byId('r7').wage_order}): ${peso(byId('r7').tiers[0]!.rate)} a day in Class A — Metro Cebu cities plus Compostela, Consolacion, Cordova, Liloan, Minglanilla and San Fernando — and ${peso(byId('r7').tiers[1]!.rate)} elsewhere in the region. Davao (Region XI, ${byId('r11').wage_order}): ${peso(byId('r11').tiers[0]!.rate)} non-agriculture and ${peso(byId('r11').tiers[1]!.rate)} agriculture since the September 1, 2026 tranche. CALABARZON (Region IV-A, ${byId('r4a').wage_order}): ${peso(byId('r4a').tiers[0]!.rate)} in the extended metropolitan area and component cities, ${peso(byId('r4a').tiers[1]!.rate)} in first-class municipalities, ${peso(byId('r4a').tiers[2]!.rate)} in second- to fifth-class municipalities, and ${peso(byId('r4a').tiers[5]!.rate)} for retail and service establishments with 10 or fewer workers.`,
  },
  { q: 'Which region has the lowest minimum wage?', a: lowestAnswer },
  {
    q: 'Who is exempt from the minimum wage?',
    a: `${rules.coverage.exempt_bmbe} ${rules.coverage.retail_service_le10} ${rules.coverage.kasambahay}`,
  },
  {
    q: 'What is the minimum wage for kasambahay (domestic workers)?',
    a: `Kasambahay have separate monthly minimum wages under RA 10361, set by each regional board: ${peso(rules.kasambahay_monthly[0]!.monthly)} a month in NCR (Wage Order ${rules.kasambahay_monthly[0]!.wage_order}, since ${fmt(rules.kasambahay_monthly[0]!.effectivity)}), ${peso(7000)} in MIMAROPA and Central Visayas, and between ${peso(5500)} (BARMM) and ${peso(6750)} (CALABARZON) elsewhere — see the table on this page.`,
  },
  {
    q: 'What is the penalty for paying below the minimum wage?',
    a: rules.coverage.penalty + ' Complaints go to the DOLE regional office; the Single Entry Approach (SEnA) handles most wage disputes first.',
  },
  {
    q: 'Magkano ang minimum wage sa Metro Manila ngayong 2026?',
    a: live28
      ? `${peso(n28.non_agriculture)} kada araw para sa non-agriculture at ${peso(n28.other_tier)} para sa agriculture, service/retail na may 15 o mas kaunting worker, at manufacturing na wala pang 10 worker (Wage Order NCR-28, epektibo simula ${fmt(n28.effectivity)}). Katumbas ito ng humigit-kumulang ${peso(monthlyEquivalent(n28.non_agriculture, f313))} kada buwan (factor ${f313}).`
      : `${peso(n26.non_agriculture)} kada araw para sa non-agriculture at ${peso(n26.other_tier)} para sa agriculture, service/retail na may 15 o mas kaunting worker, at manufacturing na wala pang 10 worker (Wage Order NCR-26). Tataas ito sa ${peso(n28.non_agriculture)} at ${peso(n28.other_tier)} simula ${fmt(n28.effectivity)} sa ilalim ng NCR-28. Katumbas ng ${peso(n26.non_agriculture)} ang humigit-kumulang ${peso(monthlyEquivalent(n26.non_agriculture, f313))} kada buwan (factor ${f313}).`,
  },
];

const description = live28
  ? `Daily minimum wage in every Philippine region under the latest wage orders — NCR ${peso(n28.non_agriculture)} since ${fmt(n28.effectivity)} — with monthly equivalents and who is exempt.`
  : `Daily minimum wage in every Philippine region under the latest wage orders — NCR ${peso(n26.non_agriculture)}, rising to ${peso(n28.non_agriculture)} on ${fmt(n28.effectivity)} — plus monthly equivalents.`;
---

<ToolPageLayout
  title="Minimum Wage Philippines 2026 – Rates by Region & NCR Update"
  description={description}
  path="/minimum-wage-philippines/"
  h1="Minimum Wage Philippines 2026 (by Region)"
  faqs={faqs}
  related={['takeHome', 'overtime', 'holidayPay', 'thirteenth']}
  extraSchema={[datasetSchema]}
>
  <Fragment slot="answer">
    {
      live28 ? (
        <p>
          The <strong>NCR minimum wage</strong> is <strong>{peso(n28.non_agriculture)}</strong> a day for non-agriculture and
          {' '}{peso(n28.other_tier)} for agriculture, small retail/service and small manufacturing, under <strong>Wage Order
          NCR-28</strong> since <strong>{fmt(n28.effectivity)}</strong> (up ₱{n28.increase} from {peso(n26.non_agriculture)} /
          {' '}{peso(n26.other_tier)}). Across the regions the daily minimum runs from {peso(range.low)} (BARMM agriculture) to
          {' '}{peso(range.high)} (NCR); every rate below comes from the NWPC summary and the wage order itself. Pick your region
          to see the sector rate and its monthly equivalent.
        </p>
      ) : (
        <p>
          The <strong>NCR minimum wage in force</strong> is <strong>{peso(n26.non_agriculture)}</strong> a day for
          non-agriculture and {peso(n26.other_tier)} for agriculture, small retail/service and small manufacturing (Wage Order
          NCR-26). <strong>Wage Order NCR-28</strong> raises them to <strong>{peso(n28.non_agriculture)}</strong> and
          {' '}{peso(n28.other_tier)} on <strong>{fmt(n28.effectivity)}</strong>, 15 days after its {fmt(n28.date_published)}
          publication. Across the regions the daily minimum runs from {peso(range.low)} (BARMM agriculture) to
          {' '}{peso(range.high)} (NCR); every rate below comes from the NWPC summary and the wage order itself. Pick your region
          to see the sector rate and its monthly equivalent.
        </p>
      )
    }
  </Fragment>

  <Fragment slot="calculator">
    <MinimumWageCalculator client:idle />
  </Fragment>

  <h2>NCR Minimum Wage: Three Wage Orders, One in Force</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Wage order</th><th>Status</th><th>Non-agriculture</th><th>Agri / retail ≤15 / mfg &lt;10</th></tr>
      </thead>
      <tbody>
        {
          live28 ? (
            <tr><td>{n26.wage_order}</td><td>In force {fmt(n26.effectivity)}; superseded by {n28.wage_order} on {fmt(n28.effectivity)}</td><td>{peso(n26.non_agriculture)}</td><td>{peso(n26.other_tier)}</td></tr>
          ) : (
            <tr><td><strong>{n26.wage_order}</strong></td><td>In force since {fmt(n26.effectivity)}</td><td><strong>{peso(n26.non_agriculture)}</strong></td><td><strong>{peso(n26.other_tier)}</strong></td></tr>
          )
        }
        <tr><td>{n27.wage_order}</td><td>Enjoined by the courts — never took effect</td><td>{peso(n27.non_agriculture)}</td><td>{peso(n27.other_tier)}</td></tr>
        {
          live28 ? (
            <tr><td><strong>{n28.wage_order}</strong></td><td>In force since {fmt(n28.effectivity)}</td><td><strong>{peso(n28.non_agriculture)}</strong></td><td><strong>{peso(n28.other_tier)}</strong></td></tr>
          ) : (
            <tr><td>{n28.wage_order}</td><td>Published {fmt(n28.date_published)}; takes effect {fmt(n28.effectivity)}</td><td>{peso(n28.non_agriculture)}</td><td>{peso(n28.other_tier)}</td></tr>
          )
        }
      </tbody>
    </table>
  </div>
  <p>
    {n27.status} NCR-28 re-grants the same ₱{n28.increase} increase on the NCR-26 baseline through a fresh order approved on
    {' '}{fmt(n28.date_issued)}. Its Section 7 makes it effective 15 days after publication, and DOLE announced
    {' '}{fmt(n28.effectivity)} as the start date
    {n28.effectivity_source_url && <Fragment> (<a href={n28.effectivity_source_url} target="_blank" rel="noopener">{n28.effectivity_source_label}</a>)</Fragment>}.
    NWPC's statement on the NCR-27 injunction is <a href={n27.nwpc_statement_url} target="_blank" rel="noopener">here</a>; any
    court action on NCR-28 would be posted on the <a href={rules.ncr.rtwpb_url} target="_blank" rel="noopener">RTWPB-NCR page</a>.
    {' '}{rules.ncr.cola_note}
  </p>

  <h2>Daily Minimum Wage by Region (Current Wage Orders)</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Region</th><th>Wage order</th><th>In effect since</th><th>Sector / area</th><th>Daily rate</th></tr>
      </thead>
      <tbody>
        {view.regions.map((r) => {
          const tranche = trancheInEffect(r);
          return r.tiers.length === 0 ? (
            <tr>
              <td><strong>{r.name}</strong></td>
              <td colspan="4" class="text-ink-soft">{r.notes}</td>
            </tr>
          ) : (
            r.tiers.map((t, i) => (
              <tr>
                {i === 0 && <td rowspan={r.tiers.length}><strong>{r.name}</strong></td>}
                {i === 0 && <td rowspan={r.tiers.length}><a href={r.wage_order_url} target="_blank" rel="noopener">{r.wage_order}</a></td>}
                {i === 0 && <td rowspan={r.tiers.length}>{fmt(r.effectivity)}{tranche && <span class="text-ink-soft"> (tranche {fmt(tranche)})</span>}</td>}
                <td>{t.label}{t.group && <span class="text-ink-soft"> — {t.group}</span>}</td>
                <td><strong>{peso(t.rate)}</strong></td>
              </tr>
            ))
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-ink-soft">
    Rates as printed in the NWPC summary and each region's wage order; where a region is in a multi-tranche order the tranche
    in force is shown, and a scheduled order or tranche replaces the old rate on its effectivity date. Regional notes:
    {' '}{withOrder.filter((r) => r.notes).map((r) => `${r.name}: ${r.notes}`).join(' ')}
  </p>

  <h2>Increases Already Scheduled and Reviews Under Way</h2>
  <ul>
    {upcomingRegions.map((r) => (
      <li>
        <strong>{r.name} — {r.upcoming!.wage_order}:</strong> {describeRates(r.upcoming!.rates)}
        {r.upcoming!.effectivity ? ` from ${fmt(r.upcoming!.effectivity)}.` : ` — expected ${r.upcoming!.expected}, date not yet published.`}
      </li>
    ))}
    <li><strong>Formal wage reviews open, no new order yet:</strong> Central Luzon (hearings October 5 – November 11, 2026), CALABARZON, Central Visayas, Western Visayas, SOCCSKSARGEN, Cordillera, Ilocos and Northern Mindanao. New orders normally take effect 15 days after publication.</li>
  </ul>

  <h2>Daily to Monthly: The DOLE Factors</h2>
  <p>
    The Handbook on Workers' Statutory Monetary Benefits converts a daily rate to an <em>estimated equivalent monthly
    rate</em> with a factor that depends on which days you are paid for: <strong>{f365}</strong> for monthly-paid employees
    (paid every day of the month), <strong>395</strong> for daily-paid workers who work every day including rest days and
    holidays, <strong>{f313}</strong> for a six-day week with rest days unpaid but holidays paid, and <strong>{f261}</strong> for a
    five-day week. Use 305 or 253 instead of {f313} or {f261} if the eight special non-working days are unpaid. NWPC uses
    {' '}{f313} in its own press releases.
  </p>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Daily rate</th><th>× {f261} ÷ 12 (5-day week)</th><th>× {f313} ÷ 12 (6-day week)</th><th>× {f365} ÷ 12 (monthly-paid)</th></tr>
      </thead>
      <tbody>
        {[...new Set(examples)].sort((a, b) => b - a).map((d) => (
          <tr>
            <td><strong>{peso(d)}</strong></td>
            <td>{peso(monthlyEquivalent(d, f261))}</td>
            <td>{peso(monthlyEquivalent(d, f313))}</td>
            <td>{peso(monthlyEquivalent(d, f365))}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Kasambahay Monthly Minimum Wage</h2>
  <p>
    Domestic workers are covered by RA 10361 and get a <strong>monthly</strong> minimum set by separate regional wage
    orders (NWPC table, September 2026):
  </p>
  <div class="table-scroll">
    <table>
      <thead><tr><th>Region</th><th>Monthly minimum</th></tr></thead>
      <tbody>
        {rules.kasambahay_monthly.map((k) => (
          <tr>
            <td>{k.region}{k.wage_order ? <span class="text-ink-soft"> ({k.wage_order}, since {fmt(k.effectivity)})</span> : null}</td>
            <td><strong>{peso(k.monthly)}</strong>{k.note ? <span class="text-ink-soft"> — {k.note}</span> : null}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <h2>Who Is Covered, Who Is Exempt</h2>
  <ul>
    <li><strong>Covered:</strong> {rules.coverage.applies_to}</li>
    <li><strong>BMBEs:</strong> {rules.coverage.exempt_bmbe}</li>
    <li><strong>Small retail/service:</strong> {rules.coverage.retail_service_le10}</li>
    <li><strong>Kasambahay:</strong> {rules.coverage.kasambahay}</li>
    <li><strong>Penalty:</strong> {rules.coverage.penalty}</li>
  </ul>
  <p>
    Minimum wage is the floor for <strong>basic pay</strong>. Overtime, night differential, holiday pay and the 13th month are
    computed on top of it — see the <a href="/overtime-pay-calculator/">Overtime Pay Calculator</a>,
    <a href="/holiday-pay-calculator/">Holiday Pay Calculator</a> and <a href="/take-home-pay-calculator/">Take-Home Pay
    Calculator</a>.
  </p>

  <h2>Official Source</h2>
  <p>
    <a href={meta.official_source_url} target="_blank" rel="noopener">{meta.official_source_label}</a> — {meta.rule_version};
    each row links to the wage order PDF on nwpc.dole.gov.ph. Conversion factors:
    <a href={rules.divisors.source} target="_blank" rel="noopener">{rules.divisors.source_label}</a>. Last verified
    {' '}{fmt(meta.last_verified)}. AyTool is independent and not affiliated with DOLE or NWPC; confirm any figure with the
    regional board before relying on it for payroll.
  </p>
</ToolPageLayout>
