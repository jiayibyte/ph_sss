<ToolPageLayout
  title="First Time Jobseeker (RA 11261): Free Documents & Certificate"
  description="Free NBI and police clearance, PSA birth certificate and barangay clearance for first time jobseekers (RA 11261): who qualifies and how to get the certificate."
  path="/first-time-jobseeker/"
  h1="First Time Jobseeker Certificate (RA 11261): Free Documents Guide"
