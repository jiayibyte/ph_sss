---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ALL_TOOLS } from '../lib/pages';
---

<BaseLayout
  title="Page Not Found — AyTool"
  description="This page does not exist. Browse AyTool's Philippine payroll and contribution calculators."
  path="/404/"
  noindex={true}
>
  <div class="mx-auto max-w-content px-4 py-16 text-center">
    <h1 class="text-3xl font-bold text-ink">Page not found</h1>
    <p class="mt-3 text-ink-soft">
      Ay! Walang page dito. The tool you're looking for might be one of these:
    </p>
    <ul class="mx-auto mt-6 grid max-w-md gap-2 text-left">
      {
        ALL_TOOLS.map((t) => (
          <li>
            <a
              href={t.href}
              class="block rounded-lg border border-line px-4 py-2.5 text-sm font-medium text-accent hover:border-accent"
            >
              {t.label}
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mt-6">
      <a href="/" class="font-medium text-accent underline">← Back to all calculators</a>
    </p>
  </div>
</BaseLayout>
