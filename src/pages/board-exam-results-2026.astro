---
/**
 * Results hub: every 2026 PRC board exam whose results PRC has released, with
 * passers / examinees / pass rate / release date from PRC's press releases
 * (recorded in src/data/prc/2026.json), plus the target dates still ahead.
 * No lists of passers — aggregate figures only.
 */
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import prcRules from '../data/prc/2026.json';
import { PRC_PROFESSIONS, examSlug } from '../lib/prcProfessions';
import { icsPath } from '../lib/prcCalendar';
import type { PrcExamEntry, PrcRules } from '../lib/rules/types';
import { SITE } from '../../site.config';

const rules = prcRules as unknown as PrcRules;
const meta = rules.meta;
const year = rules.year;
const exams = rules.exams as PrcExamEntry[];
const today = new Date().toISOString().slice(0, 10);

const fmt = (d: string | null | undefined): string =>
  d ? new Date(d + 'T00:00:00').toLocaleDateString('en-PH', { month: 'long', day: 'numeric', year: 'numeric' }) : 'to be announced';
const pct = (p: number, e: number) => `${((p / e) * 100).toFixed(2)}%`;
const num = (n: number) => n.toLocaleString('en-PH');
const hrefFor = (examName: string): string | null =>
  PRC_PROFESSIONS.find((g) => g.exams.includes(examName))?.href ?? null;
/* Display name: the written/practical dentistry rows share one release. */
const label = (e: PrcExamEntry) => e.exam.replace(/ \(Written(, 2nd exam)?\)$/, (_m, second) => (second ? ' (2nd exam)' : ''));

const released = exams
  .filter((e) => e.results_released && e.passers && e.examinees)
  .sort((a, b) => b.results_released!.localeCompare(a.results_released!));
const releasedNoStats = exams.filter((e) => e.results_released && !e.passers);
/* Everything without a recorded release, in exam order. A held exam whose
   target has passed is "not yet recorded here" — PRC may well have released
   it; we only list figures we have transcribed. */
const pending = exams
  .filter((e) => !e.results_released)
  .sort((a, b) => (a.results_target ?? a.first_date).localeCompare(b.results_target ?? b.first_date));
const upcomingReleases = pending.filter((e) => e.results_target && e.results_target >= today);
const heldCount = exams.filter((e) => e.first_date < today).length;

/* Totals and rankings use licensure exams only; rankings also skip tiny
   cohorts (a 15-of-15 sitting is not a meaningful "highest pass rate"). */
const MIN_RANKED = 100;
const licensure = released.filter((e) => !/not a licensure/i.test(e.results_note ?? ''));
const ranked = licensure.filter((e) => e.examinees! >= MIN_RANKED);
const totalPassers = licensure.reduce((s, e) => s + e.passers!, 0);
const totalExaminees = licensure.reduce((s, e) => s + e.examinees!, 0);
const byRate = [...ranked].sort((a, b) => b.passers! / b.examinees! - a.passers! / a.examinees!);
const highest = byRate[0]!;
const lowest = byRate.at(-1)!;
const largest = [...licensure].sort((a, b) => b.examinees! - a.examinees!)[0]!;
const days = withDaysList();
const bigExams = [...licensure].filter((e) => e.results_working_days !== undefined).sort((a, b) => b.examinees! - a.examinees!).slice(0, 5);
function withDaysList() {
  const w = released.filter((e) => e.results_working_days !== undefined).map((e) => e.results_working_days!);
  const sorted = [...w].sort((a, b) => a - b);
  return { min: sorted[0] ?? 0, max: sorted.at(-1) ?? 0, median: sorted[Math.floor(sorted.length / 2)] ?? 0, count: w.length };
}
const latest = released[0]!;
const nextRelease = upcomingReleases[0];

const datasetSchema = {
  '@context': 'https://schema.org',
  '@type': 'Dataset',
  name: `PRC Board Exam Results ${year}: passers, examinees and release dates`,
  description: `Aggregate results of every ${year} Philippine licensure examination released so far — passers, examinees, pass rate and release date — transcribed from PRC's results press releases.`,
  url: `${SITE.url}/board-exam-results-2026/`,
  creator: { '@type': 'Organization', name: 'Professional Regulation Commission (source data)' },
  isBasedOn: 'https://www.prc.gov.ph/articles/exam-results',
  dateModified: meta.last_verified,
  keywords: ['board exam results 2026', 'PRC passing rate', 'licensure examination results', 'Philippines'],
  distribution: [{ '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${SITE.url}/data/prc-board-exam-schedule-${year}.json` }],
  temporalCoverage: `${meta.effective_from}/${meta.effective_to}`,
  spatialCoverage: { '@type': 'Place', name: 'Philippines' },
};

const faqs = [
  {
    q: `Which ${year} board exam had the highest passing rate so far?`,
    a: `Among the ${ranked.length} licensure exams on this page with at least ${MIN_RANKED} examinees, ${label(highest)} (${highest.dates_display}): ${num(highest.passers!)} of ${num(highest.examinees!)} passed, ${pct(highest.passers!, highest.examinees!)}, released ${fmt(highest.results_released)}. The lowest was ${label(lowest)} (${lowest.dates_display}) at ${pct(lowest.passers!, lowest.examinees!)} — ${num(lowest.passers!)} of ${num(lowest.examinees!)}.`,
  },
  {
    q: `What is the biggest board exam of ${year} by number of examinees?`,
    a: `${label(largest)} (${largest.dates_display}) with ${num(largest.examinees!)} examinees, of whom ${num(largest.passers!)} passed (${pct(largest.passers!, largest.examinees!)}).${largest.results_note ? ` ${largest.results_note}.` : ''} Across the ${licensure.length} licensure exam releases on this page, ${num(totalPassers)} of ${num(totalExaminees)} examinees passed (${pct(totalPassers, totalExaminees)}).`,
  },
  {
    q: 'How fast does PRC release board exam results?',
    a: `Fast for most exams: across the ${days.count} ${year} releases whose headline states it, PRC took ${days.min} to ${days.max} working days after the last exam day, with a median of ${days.median}. The five biggest exams this year: ${bigExams
      .map((e) => `${label(e)} ${e.results_working_days} working day${e.results_working_days === 1 ? '' : 's'} (${num(e.examinees!)} examinees)`)
      .join('; ')}.`,
  },
  {
    q: 'Where do I check the official list of passers?',
    a: 'Only on prc.gov.ph — PRC posts each release as a news article with the alphabetical list of passers, the top 10 and the top-performing schools — and on PRC\'s official Facebook page. Your own per-subject ratings appear in LERIS (online.prc.gov.ph) once PRC opens verification for that exam. AyTool publishes the aggregate figures only and does not host lists of passers.',
  },
  {
    q: `What board exam results are still coming in ${year}?`,
    a: nextRelease
      ? `${upcomingReleases.length} exams have results due by their target dates. Next: ${upcomingReleases
          .slice(0, 5)
          .map((e) => `${e.exam} (${e.dates_display}) — target ${fmt(e.results_target)}`)
          .join('; ')}. Targets are the dates printed in PRC Resolution No. 2113, s. 2025; the actual release is announced on prc.gov.ph.`
      : `Every ${year} exam with a target date has been released or its target has passed; see the table for exams still awaiting PRC's announcement.`,
  },
  {
    q: 'What happens after I pass?',
    a: 'PRC announces the online initial registration schedule for the new professionals with each results release (typically two to six weeks later) — you book an appointment through LERIS, bring the system-generated registration form and a valid ID, sign the Roster of Registered Professionals and claim your Professional ID and certificate. Oath-taking dates and venues are announced separately by PRC and the profession\'s accredited organisation.',
  },
  {
    q: `Ilan ang pumasa sa board exam ${year}?`,
    a: `Sa ${licensure.length} na licensure exam na may resulta na ngayong ${year}, ${num(totalPassers)} sa ${num(totalExaminees)} examinees ang pumasa (${pct(totalPassers, totalExaminees)}). Pinakamataas ang passing rate ng ${label(highest)} (${pct(highest.passers!, highest.examinees!)}); pinakamababa ang ${label(lowest)} (${pct(lowest.passers!, lowest.examinees!)}). Ang pinakahuling resulta ay ${label(latest)}, inilabas noong ${fmt(latest.results_released)}.`,
  },
];
---

<ToolPageLayout
  title={`PRC Board Exam Results ${year} – Passing Rates & Release Dates`}
  description=`Every ${year} PRC board exam result so far: passers, examinees, passing rate and release date from PRC's press releases, plus the results still to come.`
  path="/board-exam-results-2026/"
  h1={`PRC Board Exam Results ${year}: Passing Rates by Exam`}
  faqs={faqs}
  related={['prc', 'nursingSchedule', 'letSchedule', 'criminologySchedule']}
  isApp={false}
  extraSchema={[datasetSchema]}
>
  <Fragment slot="answer">
    <p>
      PRC has released results for <strong>{licensure.length} of the {year} licensure exams</strong> held so far
      ({heldCount} of {exams.length} scheduled exams have been held): <strong>{num(totalPassers)} of {num(totalExaminees)}
      examinees passed ({pct(totalPassers, totalExaminees)})</strong>. The latest is the
      <strong>{label(latest)}</strong> ({latest.dates_display}), released {fmt(latest.results_released)} — {num(latest.passers!)}
      of {num(latest.examinees!)} passed ({pct(latest.passers!, latest.examinees!)}). Highest passing rate among exams with
      {MIN_RANKED}+ examinees:
      {label(highest)} at {pct(highest.passers!, highest.examinees!)}; lowest: {label(lowest)} at
      {pct(lowest.passers!, lowest.examinees!)}.
      {nextRelease && (
        <Fragment>
          {' '}Next result due: <strong>{nextRelease.exam}</strong>, target {fmt(nextRelease.results_target)}.
        </Fragment>
      )}
      {' '}Every figure is transcribed from PRC's results press release; this page carries no lists of passers.
    </p>
  </Fragment>

  <h2>{year} Board Exam Results Released So Far</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Examination</th>
          <th>Exam dates</th>
          <th>Results released</th>
          <th>Passers</th>
          <th>Examinees</th>
          <th>Pass rate</th>
        </tr>
      </thead>
      <tbody>
        {released.map((e) => {
          const href = hrefFor(e.exam);
          return (
            <tr id={examSlug(e.exam)}>
              <td>
                {href ? <a href={href}><strong>{label(e)}</strong></a> : <strong>{label(e)}</strong>}
                {e.results_note && <div class="text-xs text-ink-soft">{e.results_note}</div>}
              </td>
              <td>{e.dates_display}{e.note && <div class="text-xs text-ink-soft">{e.note}</div>}</td>
              <td>
                {e.results_url ? <a href={e.results_url} target="_blank" rel="noopener">{fmt(e.results_released)}</a> : fmt(e.results_released)}
                {e.results_working_days !== undefined && (
                  <div class="text-xs text-ink-soft">
                    {e.results_working_days} working day{e.results_working_days === 1 ? '' : 's'} (PRC)
                  </div>
                )}
              </td>
              <td>{num(e.passers!)}</td>
              <td>{num(e.examinees!)}</td>
              <td><strong>{pct(e.passers!, e.examinees!)}</strong></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="text-sm text-ink-soft">
    Each release date links to PRC's own announcement. Counts are as printed by PRC; the pass rate is passers ÷ examinees. "Working days (PRC)" is the figure in PRC's own
    headline, counted from the last exam day.{releasedNoStats.length > 0 && ` ${releasedNoStats.map((e) => e.exam).join(', ')}: released with the paired examination above.`}
  </p>

  <h2>Exams Without a Recorded Result Yet</h2>
  <div class="table-scroll">
    <table>
      <thead>
        <tr><th>Examination</th><th>Exam dates</th><th>Target release date</th><th></th></tr>
      </thead>
      <tbody>
        {pending.map((e) => {
          const href = hrefFor(e.exam);
          return (
            <tr>
              <td>{href ? <a href={href}>{e.exam}</a> : e.exam}{e.note && <div class="text-xs text-ink-soft">{e.note}</div>}</td>
              <td>{e.dates_display}</td>
              <td>
                {e.results_target ? fmt(e.results_target) : 'To be announced'}
                {e.first_date < today && (!e.results_target || e.results_target < today) && (
                  <span class="text-ink-soft"> — exam held; not yet recorded here, check prc.gov.ph</span>
                )}
              </td>
              <td class="text-xs">{e.first_date >= today && <a href={icsPath(year, e)}>Add to calendar</a>}</td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p>
    Target dates are those printed in PRC Resolution No. 2113, s. 2025. PRC often releases earlier than the target (the
    February PNLE came out 13 days early) and occasionally later; the actual release is announced only on prc.gov.ph.
    The full schedule with filing windows is on the <a href="/prc-board-exam-schedule/">PRC Board Exam Schedule {year}</a>.
  </p>

  <h2>How to Read a PRC Results Release</h2>
  <ul>
    <li><strong>Passers and examinees:</strong> PRC prints "X out of Y passed"; the pass rate is not printed and is computed here.</li>
    <li><strong>Withheld results:</strong> some releases hold back a handful of examinees "pending final determination of their liabilities" — those are not counted as passers or failures.</li>
    <li><strong>Top performing schools and topnotchers:</strong> published as separate PDFs linked from the release; not reproduced here.</li>
    <li><strong>Registration:</strong> each release states when online initial registration for the new professionals opens — usually two to six weeks after the results.</li>
    <li><strong>Verification of ratings:</strong> your per-subject scores appear in LERIS once PRC opens the service for that exam.</li>
  </ul>

  <h2>Official Source</h2>
  <p>
    Every row is transcribed from the corresponding results press release on
    <a href="https://www.prc.gov.ph/articles/exam-results" target="_blank" rel="noopener">prc.gov.ph — Exam Results</a>; the
    per-profession pages linked in the table cite the exact article. Schedule and target dates:
    <a href={meta.official_source_url} target="_blank" rel="noopener">{meta.official_source_label}</a>. Last verified
    {fmt(meta.last_verified)}. AyTool is independent, does not host lists of passers, and cannot verify individual ratings.
  </p>
</ToolPageLayout>
