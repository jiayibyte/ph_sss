---
/**
 * First-party engagement beacon. Server logs show which pages a visitor
 * requested, not what happened on them: a one-page visit looks like "0 seconds"
 * whether it lasted 3 seconds or 5 minutes. This reports, once the page is
 * hidden or closed:
 *   t = seconds the page was actually visible (capped at 30 min)
 *   d = deepest scroll position reached, % of page height
 *   a = kinds of controls used: input (a calculator/filter field), search,
 *       ics (add to calendar), subscribe, share, out (external link), nav
 *       (internal link), copy
 * HARD RULE: never what was typed, selected or copied — only that it happened.
 * No cookie or storage; `pv` is a random id for this page view only, so repeated
 * beacons from one view can be merged. nginx answers POST /e with 204 and the
 * access log keeps the query string (infra/nginx-aytool.conf).
 */
---

<script>
  const pv = Math.random().toString(36).slice(2, 10);
  let visibleSince: number | null = document.visibilityState === 'visible' ? performance.now() : null;
  let visibleMs = 0;
  let depth = 0;
  const acts = new Set<string>();

  const measure = () => {
    const height = document.documentElement.scrollHeight || 1;
    depth = Math.max(depth, Math.min(100, Math.round(((window.scrollY + window.innerHeight) / height) * 100)));
  };
  measure();
  addEventListener('scroll', measure, { passive: true });

  document.addEventListener(
    'input',
    (e) => acts.add((e.target as Element | null)?.matches?.('input[type="search"]') ? 'search' : 'input'),
    true,
  );
  document.addEventListener('copy', () => acts.add('copy'), true);
  document.addEventListener(
    'click',
    (e) => {
      const el = (e.target as Element | null)?.closest?.('a, button');
      if (!el) return;
      const tag = el.getAttribute('data-track');
      if (tag) return void acts.add(tag);
      const href = el.getAttribute('href') ?? '';
      if (href.endsWith('.ics')) acts.add('ics');
      else if (/facebook\.com\/sharer|m\.me|fb-messenger|x\.com\/intent|twitter\.com\/intent/.test(href)) acts.add('share');
      else if (/^https?:/.test(href) && !href.startsWith(location.origin)) acts.add('out');
      else if (href.startsWith('/') && !href.startsWith('/data/')) acts.add('nav');
    },
    true,
  );

  const send = () => {
    if (visibleSince !== null) {
      visibleMs += performance.now() - visibleSince;
      visibleSince = null;
    }
    const q = new URLSearchParams({
      pv,
      p: location.pathname,
      t: String(Math.min(1800, Math.round(visibleMs / 1000))),
      d: String(depth),
      a: [...acts].join('.'),
    });
    navigator.sendBeacon?.(`/e?${q}`);
  };
  document.addEventListener('visibilitychange', () => {
    if (document.visibilityState === 'hidden') send();
    else visibleSince = performance.now();
  });
  addEventListener('pagehide', send);
</script>
