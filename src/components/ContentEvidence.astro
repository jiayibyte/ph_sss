---
import { pageEvidence } from '../lib/pageEvidence';
import { correctionsFor, reviewsFor, formatEditorialDate } from '../lib/editorial';
interface Props { pagePath: string; bodyHtml: string }
const { pagePath, bodyHtml } = Astro.props;
const sources = pageEvidence(pagePath, bodyHtml);
const reviews = reviewsFor(pagePath);
const corrections = correctionsFor(pagePath);
---

<section id="page-evidence" class="content-prose mt-6 rounded-lg border border-line bg-surface-soft p-4 text-sm leading-relaxed" aria-label="Sources and review record">
  <details>
    <summary class="cursor-pointer font-semibold text-ink">Sources, review status and corrections</summary>
    <p class="mt-3">
      Maintainer: <a href="/about/maintainer/">AyTool maintainer</a>.
      {reviews.length === 0
        ? ' Independent professional review: no completed review is recorded for this page.'
        : ' Independent professional review records:'}
    </p>
    {reviews.map((review) => <p class="mt-2"><a href={review.profileUrl}>{review.name}</a> ({review.qualification}) — {review.scope}; reviewed <time datetime={review.reviewedOn}>{formatEditorialDate(review.reviewedOn)}</time>. <a href={review.evidenceUrl}>Review record</a>.</p>)}
    <p class="mt-2 text-ink-soft">
      Dataset checks below are recorded source-check dates, not professional certifications.
      An undated reference link does not imply a new review. <a href="/editorial-policy/">How we prepare and review content</a>.
    </p>
    {sources.length > 0 && <div class="table-scroll mt-3"><table>
      <caption class="text-left">Sources used by this page</caption>
      <thead><tr><th>Claim or data</th><th>Source</th><th>Recorded source check</th></tr></thead>
      <tbody>{sources.map((source) => <tr><td>{source.claim}</td><td><a href={source.url} target="_blank" rel="noopener">{source.label}</a></td><td>{source.checkedOn ? <time datetime={source.checkedOn}>{formatEditorialDate(source.checkedOn)}</time> : 'Not separately recorded'}</td></tr>)}</tbody>
    </table></div>}
    {sources.length === 0 && <p class="mt-2">This page has no separately registered source-check record. Follow the cited references in the guide and contact us if a source is missing.</p>}
    {corrections.length > 0 && <ul class="mt-3 list-disc pl-5">{corrections.map((c) => <li><time datetime={c.date}>{formatEditorialDate(c.date)}</time>: {c.title}. <a href="/corrections/">Read the correction</a>.</li>)}</ul>}
    <p class="mt-3"><a href="/corrections/">Public correction log and reporting instructions</a> · <a href="/for-publishers/">Review, cite or reuse our resources</a></p>
  </details>
</section>
