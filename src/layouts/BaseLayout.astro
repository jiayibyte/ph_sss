---
import '../styles/global.css';
import { SITE, NOT_AFFILIATED } from '../../site.config';
import { TOOL_PAGES, TRUST_PAGES, ALL_TOOLS } from '../lib/pages';

interface Props {
  title: string;
  description: string;
  /** Path with leading & trailing slash, e.g. "/sss-contribution-table/". */
  path: string;
  noindex?: boolean;
  /** Extra JSON-LD objects (WebApplication, FAQPage, Dataset...). */
  schema?: Record<string, unknown>[];
}

const { title, description, path, noindex = false, schema = [] } = Astro.props;
const canonical = `${SITE.url}${path}`;
const ogImage = `${SITE.url}/og-default.png`;
const { accent, accentStrong, accentSoft } = SITE.palette;

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: SITE.name,
  url: SITE.url,
  email: SITE.contactEmail,
  description: `${SITE.tagline}. ${NOT_AFFILIATED}`,
};

const navLinks = [
  TOOL_PAGES.sssTable,
  TOOL_PAGES.thirteenth,
  TOOL_PAGES.takeHome,
  TOOL_PAGES.philhealth,
];
---

<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <style set:html={`:root{--accent:${accent};--accent-strong:${accentStrong};--accent-soft:${accentSoft}}`}
    ></style>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(organizationSchema)}
    />
    {schema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}
    {
      SITE.ga4Id && (
        <>
          <script
            type="text/partytown"
            src={`https://www.googletagmanager.com/gtag/js?id=${SITE.ga4Id}`}
          />
          <script
            type="text/partytown"
            set:html={`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)};gtag('js',new Date());gtag('config','${SITE.ga4Id}');`}
          />
        </>
      )
    }
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-2 focus:top-2 focus:z-50 focus:rounded focus:bg-accent focus:px-3 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-wide flex-wrap items-center gap-x-6 gap-y-2 px-4 py-3">
        <a href="/" class="flex items-center gap-2 font-bold text-ink" aria-label="AyTool home">
          <svg
            width="26"
            height="26"
            viewBox="0 0 32 32"
            fill="none"
            aria-hidden="true"
          >
            <rect width="32" height="32" rx="8" fill="var(--accent)"></rect>
            <path
              d="M9 22 L14.5 9 h3 L23 22 h-3.4 l-1.1-3 h-5 l-1.1 3 Z M14.6 16.4 h2.8 L16 12.5 Z"
              fill="#fff"></path>
          </svg>
          <span class="text-lg">AyTool</span>
        </a>
        <nav class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Main">
          {
            navLinks.map((l) => (
              <a href={l.href} class="text-ink-soft hover:text-accent-strong">
                {l.short}
              </a>
            ))
          }
          <a href="/#all-calculators" class="font-medium text-accent hover:text-accent-strong"
            >All calculators</a
          >
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="mt-16 border-t border-line bg-surface-soft">
      <div class="mx-auto grid max-w-wide gap-8 px-4 py-10 sm:grid-cols-3">
        <div>
          <p class="flex items-center gap-2 font-bold text-ink">AyTool</p>
          <p class="mt-2 text-sm italic text-ink-soft">{SITE.slogan}</p>
          <p class="mt-3 text-xs leading-relaxed text-ink-soft">{NOT_AFFILIATED}</p>
          <p class="mt-3 text-xs text-ink-soft">
            Questions or corrections: <a
              class="underline hover:text-accent-strong"
              href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a
            >
          </p>
        </div>
        <nav aria-label="Related Philippine payroll calculators">
          <h2 class="text-sm font-semibold text-ink">Related Philippine Payroll Calculators</h2>
          <ul class="mt-2 space-y-1 text-sm">
            {
              ALL_TOOLS.map((t) => (
                <li>
                  <a href={t.href} class="text-ink-soft hover:text-accent-strong">
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <nav aria-label="About this site">
          <h2 class="text-sm font-semibold text-ink">About this site</h2>
          <ul class="mt-2 space-y-1 text-sm">
            {
              TRUST_PAGES.map((t) => (
                <li>
                  <a href={t.href} class="text-ink-soft hover:text-accent-strong">
                    {t.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
      <div class="border-t border-line py-4 text-center text-xs text-ink-soft">
        © 2026 AyTool — an independent Philippine payroll calculator. Estimates only; always
        confirm with official sources.
      </div>
    </footer>
  </body>
</html>
