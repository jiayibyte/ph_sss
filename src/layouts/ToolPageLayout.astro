---
import { existsSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from './BaseLayout.astro';
import ShareButtons from '../components/ShareButtons.astro';
import { SITE } from '../../site.config';
import { TOOL_PAGES, type PageRef } from '../lib/pages';
import { pageDates } from '../lib/lastmod.mjs';

export interface Faq {
  q: string;
  a: string;
}

interface Props {
  title: string;
  description: string;
  path: string;
  h1: string;
  faqs?: Faq[];
  /** Keys into TOOL_PAGES for the Related section. */
  related: Array<keyof typeof TOOL_PAGES>;
  /** Set to add WebApplication schema (calculator pages). */
  isApp?: boolean;
  /** schema.org applicationCategory for the WebApplication node. */
  appCategory?: string;
  /** Extra JSON-LD (e.g. Dataset for PRC). */
  extraSchema?: Record<string, unknown>[];
  /** Offer an <iframe> embed of the calculator (needs a matching /embed/<slug>/ page). Defaults to isApp. */
  embeddable?: boolean;
}

const {
  title,
  description,
  path: pagePath,
  h1,
  faqs = [],
  related,
  isApp = true,
  appCategory = 'FinanceApplication',
  extraSchema = [],
  embeddable = isApp,
} = Astro.props;

const { published, modified } = pageDates(pagePath);

/* Visible "Updated" date (GEO §5.4 — dates in the body). Derived from the same
   lastmod source as the sitemap and JSON-LD dateModified so the three never drift. */
const updatedLabel = new Date(modified + 'T00:00:00').toLocaleDateString('en-PH', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});

/* Per-page OG card generated by scripts/generate-og.mjs; falls back to og-default.png. */
const ogSlug = pagePath.replace(/\//g, '');
const ogPath = `/og/${ogSlug}.png`;
const ogImage = existsSync(path.join(process.cwd(), 'public', ogPath)) ? ogPath : undefined;

/* Embed snippet: the <a> line is the real backlink; the iframe alone passes
   almost nothing. Fixed height with max-width so it degrades on phones. */
const embedUrl = `${SITE.url}/embed/${ogSlug}/`;
const embedSnippet = embeddable
  ? `<iframe src="${embedUrl}" title="${h1} – AyTool" width="100%" height="760" style="max-width:720px;border:0" loading="lazy"></iframe>\n<p><a href="${SITE.url}${pagePath}">${h1}</a> by AyTool</p>`
  : null;

const schema: Record<string, unknown>[] = [...extraSchema];
if (isApp) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    url: `${SITE.url}${pagePath}`,
    applicationCategory: appCategory,
    operatingSystem: 'Any',
    browserRequirements: 'Requires JavaScript',
    description,
    datePublished: published,
    dateModified: modified,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'PHP' },
    publisher: { '@type': 'Organization', name: SITE.name, url: `${SITE.url}/` },
  });
}
if (faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}

const relatedPages: PageRef[] = related.map((k) => TOOL_PAGES[k]);
---

<BaseLayout
  title={title}
  description={description}
  path={pagePath}
  schema={schema}
  pageName={h1}
  ogImage={ogImage}
>
  <article class="mx-auto max-w-content px-4 pt-6">
    <nav aria-label="Breadcrumb" class="mb-3 text-xs text-ink-soft">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li><a href="/" class="hover:text-accent-strong hover:underline">Home</a></li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-ink">{h1}</li>
      </ol>
    </nav>
    <h1 class="text-2xl font-bold leading-tight text-ink sm:text-3xl">{h1}</h1>
    <div class="answer-first mt-3 text-[15px] leading-relaxed text-ink">
      <slot name="answer" />
    </div>
    <div class="mt-2 flex flex-wrap items-center gap-x-4 gap-y-1">
      <p class="text-xs font-medium text-ink-soft">
        Updated: <time datetime={modified}>{updatedLabel}</time>
      </p>
      <ShareButtons path={pagePath} title={title} />
    </div>

    <section class="mt-5" aria-label="Calculator">
      <slot name="calculator" />
    </section>

    {
      embedSnippet && (
        <details class="mt-4 rounded-lg border border-line bg-surface px-4 py-3 text-sm">
          <summary class="cursor-pointer font-semibold text-ink">Embed this calculator on your website</summary>
          <p class="mt-2 text-ink-soft">
            Free for any site — HR blogs, review centers, cooperatives. Paste this HTML where the
            calculator should appear; it keeps following the official rates on its own.
          </p>
          <pre class="mt-2 overflow-x-auto rounded-md bg-surface-soft p-3 text-xs leading-relaxed"><code>{embedSnippet}</code></pre>
        </details>
      )
    }

    <div class="content-prose mt-4">
      <slot />
    </div>

    {
      ogImage && (
        <figure class="mt-5 rounded-lg border border-line bg-surface-soft p-3">
          <img
            src={ogImage}
            alt={`${h1} — AyTool summary card`}
            width="1200"
            height="630"
            loading="lazy"
            decoding="async"
            class="w-full rounded-md border border-line"
          />
          <figcaption class="mt-2 flex flex-wrap items-center justify-between gap-2 text-xs text-ink-soft">
            <span>Save or share this card — the page address is printed on it.</span>
            <ShareButtons path={pagePath} title={title} />
          </figcaption>
        </figure>
      )
    }


    {
      faqs.length > 0 && (
        <section class="content-prose mt-4">
          <h2 id="faq">Frequently Asked Questions</h2>
          {faqs.map((f) => (
            <details class="group mb-2 rounded-lg border border-line bg-surface px-4 py-3">
              <summary class="cursor-pointer text-[15px] font-semibold text-ink marker:text-accent">
                {f.q}
              </summary>
              <p class="mt-2 text-[15px] text-ink" set:html={f.a} />
            </details>
          ))}
        </section>
      )
    }

    <section class="mt-12" aria-label="Related Philippine payroll calculators">
      <h2 class="text-lg font-bold text-ink">Related Philippine Payroll Calculators</h2>
      <ul class="mt-3 grid gap-3 sm:grid-cols-2">
        {
          relatedPages.map((r) => (
            <li>
              <a
                href={r.href}
                class="block rounded-lg border border-line bg-surface p-4 hover:border-accent"
              >
                <span class="font-semibold text-accent">{r.label}</span>
                <span class="mt-1 block text-sm text-ink-soft">{r.blurb}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>
  </article>
</BaseLayout>
